{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/client/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@ml/*": ["./src/ml/*"],
      "@server/*": ["./src/server/*"]
    }
  },
  "module": {
    "type": "es6"
  }
}
