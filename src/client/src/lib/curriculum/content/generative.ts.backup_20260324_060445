        "gamma": trial.suggest_float("gamma", 0.0, 5.0),
    }

    # Time-series cross-validation (no shuffling!)
    tscv = TimeSeriesSplit(n_splits=3)
    sharpes = []

    for train_idx, val_idx in tscv.split(X):
