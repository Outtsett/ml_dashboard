{% block label_generation %}
{% if label_strategy == "none" %}
def generate_labels(raw, args):
    raise RuntimeError("label_strategy=none — this generated model needs an "
                       "override of generate_labels() before it can train.")
{% else %}
from src.ml.shared.labels import {{ label_strategy }}_labels as _label_fn  # noqa: E402

_LABEL_PARAMS: dict = {{ label_params | python_repr }}


def generate_labels(raw, args):
    """Return (labels, valid_mask) per the configured label_strategy.

    Each shared.labels adapter takes a single ``params`` dict; the positional
    OHLCV args differ per strategy:

      triple_barrier        → (close, high, low, params)
      next_close_direction  → (close, params)
      range_bucket          → (close, params)
      structural            → (high, low, params)
    """
    {% if label_strategy == "triple_barrier" %}
    return _label_fn(raw["close"], raw["high"], raw["low"], _LABEL_PARAMS)
    {% elif label_strategy == "next_close_direction" %}
    return _label_fn(raw["close"], _LABEL_PARAMS)
    {% elif label_strategy == "range_bucket" %}
    return _label_fn(raw["close"], _LABEL_PARAMS)
    {% elif label_strategy == "structural" %}
    return _label_fn(raw["high"], raw["low"], _LABEL_PARAMS)
    {% else %}
    raise RuntimeError(
        "Unknown label_strategy={{ label_strategy | python_repr }} — _base.py.j2 "
        "must be extended to handle this strategy."
    )
    {% endif %}
{% endif %}
{% endblock %}


