# --------------------------------------------------------------------------- #
# Main pipeline — load, label, filter, walk-forward (or single fold), report.
# --------------------------------------------------------------------------- #


def _filter_valid(X, y, valid, timestamps):
    keep = np.flatnonzero(valid)
    X = X[keep]; y = y[keep]; timestamps = timestamps[keep]
    finite = np.isfinite(X).all(axis=1)
    return X[finite], y[finite], timestamps[finite]


def run_training(args: argparse.Namespace) -> dict:
    emit_log(f"[{{ template_id }}] Loading {args.symbol}@{args.timeframe} "
             f"(categories={args.feature_categories or 'all'})")
    matrix, names, timestamps, raw = load_features(args)
    n_total = matrix.shape[0]
    emit_log(f"[{{ template_id }}] Loaded {n_total:,} bars x {matrix.shape[1]} features")

    if getattr(args, "label_set_parquet", None):
        from src.ml.shared.label_sets import load_label_set
        emit_log(f"[{{ template_id }}] Loading persisted label set {args.label_set_parquet}")
        labels, valid, set_diag = load_label_set(
            args.label_set_parquet, timestamps,
            binary={{ "True" if label_strategy in ("next_close_direction", "triple_barrier") else "False" }},
        )
        emit_log(f"[{{ template_id }}] Label set aligned: {set_diag}")
    else:
        emit_log(f"[{{ template_id }}] Generating {{ label_strategy }} labels")
        labels, valid = generate_labels(raw, args)

    X, y, ts_kept = _filter_valid(matrix, labels, valid, timestamps)
    emit_log(f"[{{ template_id }}] After dropping non-finite rows: {X.shape[0]:,} samples")

    {% include "_walk_forward.py.j2" %}

    {% block eval_block %}
    {# W1.c (ml-eval) lands the per-fold rollup + diagnostics.json writer #}
    {# in `_eval_classification.py.j2` / `_eval_regression.py.j2`.        #}
    {# Until then the W1 stub returns the per-fold list verbatim.          #}
    diagnostics = {
        "model_id": args.model_id,
        "symbol": args.symbol,
        "timeframe": args.timeframe,
        "template_id": "{{ template_id }}",
        "template_version": "{{ template_version }}",
        "n_total_bars": int(n_total),
        "n_kept_samples": int(X.shape[0]),
        "n_features": int(X.shape[1]),
        "feature_names": list(names),
        "fold_results": fold_results,
    }
    {% endblock %}

    return diagnostics


# --------------------------------------------------------------------------- #
# Entry point — try/except + emit_done wrapper, identical to
# xgb_classifier/main.py:513-525.
# --------------------------------------------------------------------------- #


def main() -> None:
    args = _parse_args()
    t0 = time.perf_counter()
    try:
        diagnostics = run_training(args)
        elapsed = time.perf_counter() - t0
        diagnostics["train_secs"] = round(elapsed, 2)
        emit_done(
            model_path=str(_PROJECT_ROOT / "data" / "models" / args.model_id),
            diagnostics=diagnostics,
        )
    except Exception as exc:
        emit_error(message=str(exc), details=traceback.format_exc())
        raise


if __name__ == "__main__":
    main()
