{# ---------------------------------------------------------------------- #}
{# pytorch_vae.py.j2 — variational autoencoder (W3.b)                     #}
{#                                                                         #}
{# Same overall shape as pytorch_autoencoder.py.j2 but the bottleneck is   #}
{# replaced with a VariationalHead that outputs (mu, logvar). At training  #}
{# time the latent is sampled via the reparameterization trick:            #}
{#     z = mu + exp(logvar/2) * eps,    eps ~ N(0, I)                      #}
{# At inference time z = mu (deterministic).                               #}
{#                                                                         #}
{# Loss = MSE(x, x_recon) + beta * KL(N(mu, sigma^2) || N(0, I))           #}
{# where KL = -0.5 * sum(1 + logvar - mu^2 - exp(logvar)) per sample.     #}
{#                                                                         #}
{# Hyperparameters consumed:                                               #}
{#   hidden_dims          (list[int])                                     #}
{#   latent_dim           (int)                                           #}
{#   beta                 (float)        — KL weight (default 1.0)        #}
{#   dropout              (float)                                         #}
{#   learning_rate        (float)                                         #}
{#   n_epochs             (int)                                           #}
{#   batch_size           (int)                                           #}
{#   early_stop_patience  (int)                                           #}
{#                                                                         #}
{# OOS predictions schema (oos_predictions.parquet):                       #}
{#   prediction = anomaly_score  (per-sample reconstruction MSE)           #}
{#   confidence = 1.0                                                       #}
{# ---------------------------------------------------------------------- #}
{% extends "_base.py.j2" %}

