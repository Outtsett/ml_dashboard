{# ============================================================================
   _eval_regression.py.j2 — shared regression eval logic.

   Same shape as _eval_classification.py.j2: included by family templates via
   `{% include "_eval_regression.py.j2" %}`. Renders to PURE PYTHON with zero
   Jinja substitutions. Output functions:

     - compute_fold_metrics(y_true, y_pred, fold_idx) -> dict[str, float|None]
     - simulate_pnl_regression(preds, prices, ts, threshold) -> dict
     - _emit_metric_declarations() -> None
     - build_diagnostics(model, y_true, y_pred, ts, prices, fold_results) -> dict
     - write_oos_predictions(ts, y_true, y_pred, output_path) -> None

   Trade rule: fire only when |pred| exceeds threshold; direction = sign(pred).
   Cost model: src/config/cost_model.json. Output schema mirrors classification:
   {timestamp, symbol, prediction (real-valued), confidence (=1.0 default)}.
   ============================================================================ #}
# ──────────────────────────────────────────────────────────────────────────────
# Shared regression eval (rendered from _eval_regression.py.j2)
# ──────────────────────────────────────────────────────────────────────────────
import json as _eval_json
import math as _eval_math
from pathlib import Path as _EvalPath

import numpy as _eval_np

try:
    from src.ml.shared.protocol import emit_metric_declarations as _eval_emit_decls
except Exception:  # pragma: no cover
    def _eval_emit_decls(_decls):  # type: ignore[no-redef]
        return None

def _eval_locate_cost_model() -> _EvalPath:
    """Walk up from this file looking for src/config/cost_model.json.

    Generated models live at src/ml/<model_id>/eval_block.py — parents[3] is
    the project root. But this fragment may also be exercised standalone
    (smoke tests, ad-hoc imports), so we walk up defensively.
    """
    here = _EvalPath(__file__).resolve()
    for parent in [here, *here.parents]:
        candidate = parent / "src" / "config" / "cost_model.json"
        if candidate.is_file():
            return candidate
    return here.parents[min(3, len(here.parents) - 1)] / "src" / "config" / "cost_model.json"


_EVAL_COST_MODEL_PATH = _eval_locate_cost_model()


# ─── Internal helpers ─────────────────────────────────────────────────────────


def _eval_load_cost_model(symbol: str) -> dict:
    """Same cost-model contract as _eval_classification.py.j2."""
    try:
        cost = _eval_json.loads(_EVAL_COST_MODEL_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        cost = {}
    s = (symbol or "").upper()
    if s in cost:
        c = cost[s]
        return {
            "round_trip_points": float(
                c.get("total_round_trip_points", c.get("total_round_trip", 1.0))
            ),
            "point_value": float(c.get("point_value", c.get("tick_value", 1.0))),
            "tick_value": float(c.get("tick_value", 1.0)),
            "fallback_bp": 0.0,
        }
    return {
        "round_trip_points": 0.0,
        "point_value": 1.0,
        "tick_value": 1.0,
        "fallback_bp": 0.5,
    }


def _eval_safe_finite(x) -> float | None:
    if x is None:
        return None
    try:
        v = float(x)
    except (TypeError, ValueError):
        return None
    if not _eval_np.isfinite(v):
        return None
    return v


def _eval_to_1d(x) -> _eval_np.ndarray:
    arr = _eval_np.asarray(x, dtype=_eval_np.float64)
    if arr.ndim > 1:
        arr = arr.reshape(-1)
    return arr


# ─── Regression metrics ──────────────────────────────────────────────────────


def _eval_mse(y_true: _eval_np.ndarray, y_pred: _eval_np.ndarray) -> float:
    return float(_eval_np.mean((y_pred - y_true) ** 2))


def _eval_mae(y_true: _eval_np.ndarray, y_pred: _eval_np.ndarray) -> float:
    return float(_eval_np.mean(_eval_np.abs(y_pred - y_true)))


def _eval_r2(y_true: _eval_np.ndarray, y_pred: _eval_np.ndarray) -> float | None:
    """Coefficient of determination. Returns None when target variance is zero."""
    ss_tot = float(((y_true - y_true.mean()) ** 2).sum())
    if ss_tot == 0.0:
        return None
    ss_res = float(((y_true - y_pred) ** 2).sum())
    return 1.0 - ss_res / ss_tot


def _eval_directional_accuracy(
    y_true: _eval_np.ndarray, y_pred: _eval_np.ndarray
) -> float | None:
    """Fraction of bars where sign(pred) matches sign(true). Zeros count as miss."""
    if y_true.size == 0:
        return None
    s_true = _eval_np.sign(y_true)
    s_pred = _eval_np.sign(y_pred)
    return float((s_true == s_pred).mean())


def _eval_pearson(y_true: _eval_np.ndarray, y_pred: _eval_np.ndarray) -> float | None:
    """Pearson product-moment correlation."""
    if y_true.size < 2:
        return None
    yt = y_true - y_true.mean()
    yp = y_pred - y_pred.mean()
    denom = _eval_np.sqrt((yt * yt).sum() * (yp * yp).sum())
    if denom == 0.0:
        return None
    return float((yt * yp).sum() / denom)


def _eval_spearman(y_true: _eval_np.ndarray, y_pred: _eval_np.ndarray) -> float | None:
    """Spearman rank correlation (Pearson on ranks). Average ranks for ties."""
    if y_true.size < 2:
        return None

    def _rankdata(a: _eval_np.ndarray) -> _eval_np.ndarray:
        order = _eval_np.argsort(a, kind="mergesort")
        sorted_a = a[order]
        ranks = _eval_np.empty(a.size, dtype=_eval_np.float64)
        i = 0
        while i < a.size:
            j = i + 1
            while j < a.size and sorted_a[j] == sorted_a[i]:
                j += 1
            avg_rank = (i + 1 + j) / 2.0
            ranks[i:j] = avg_rank
            i = j
        out = _eval_np.empty(a.size, dtype=_eval_np.float64)
        out[order] = ranks
        return out

    return _eval_pearson(_rankdata(y_true), _rankdata(y_pred))


# ─── Cost-aware PnL simulation (regression head) ─────────────────────────────


def simulate_pnl_regression(
    preds,
    prices,
    ts=None,
    threshold: float = 0.0,
    *,
    horizon_bars: int = 1,
    symbol: str = "MNQ",
) -> dict:
    """Trade only when |pred| exceeds threshold. Direction = sign(pred).

    Same overall shape as classification simulate_pnl: cost is loaded from
    src/config/cost_model.json, one trade per signal, exit at close[i+horizon],
    no overlapping trades. Returns dict with trading metrics.
    """
    p = _eval_to_1d(preds)
    close = _eval_to_1d(prices)
    if close.shape != p.shape:
        raise ValueError(
            f"prices shape {close.shape} != preds shape {p.shape}"
        )
    n = close.shape[0]
    cm = _eval_load_cost_model(symbol)
    rtp = cm["round_trip_points"]
    pv = cm["point_value"]
    fallback_bp = cm.get("fallback_bp", 0.0)
    horizon = max(1, int(horizon_bars))

    trades_pnl: list[float] = []
    trade_dirs: list[int] = []
    last_exit = -1
    thr = abs(float(threshold))
    for i in range(n - horizon):
        if i < last_exit:
            continue
        v = p[i]
        if abs(v) < thr:
            continue
        direction = +1 if v > 0 else -1
        c_in = close[i]
        c_out = close[i + horizon]
        move_points = (c_out - c_in) * direction
        if rtp > 0:
            cost_dollars = rtp * pv
        else:
            cost_dollars = (fallback_bp / 10000.0) * c_in * pv
        gross_dollars = move_points * pv
        net = gross_dollars - cost_dollars
        trades_pnl.append(net)
        trade_dirs.append(direction)
        last_exit = i + horizon

    pnl_arr = _eval_np.asarray(trades_pnl, dtype=_eval_np.float64)
    dirs = _eval_np.asarray(trade_dirs, dtype=_eval_np.int8)
    n_trades = pnl_arr.size

    if n_trades == 0:
        return {
            "total_pnl": 0.0,
            "n_trades": 0,
            "wins": 0,
            "losses": 0,
            "profit_factor": None,
            "win_rate": None,
            "mean_trade_pnl": 0.0,
            "sharpe": 0.0,
            "max_drawdown": 0.0,
            "cum_pnl_dollars": 0.0,
            "max_drawdown_dollars": 0.0,
            "max_drawdown_pct": 0.0,
            "sharpe_after_costs": 0.0,
            "avg_win_dollars": 0.0,
            "avg_loss_dollars": 0.0,
            "n_long": 0,
            "n_short": 0,
            "trade_pnl_dollars": [],
        }

    cum = _eval_np.cumsum(pnl_arr)
    running_peak = _eval_np.maximum.accumulate(cum)
    drawdown = cum - running_peak
    max_dd_dollars = float(drawdown.min())
    peak_at_dd = float(running_peak[drawdown.argmin()])
    max_dd_pct = float(max_dd_dollars / peak_at_dd) if peak_at_dd > 0 else 0.0
    wins_arr = pnl_arr[pnl_arr > 0]
    losses_arr = pnl_arr[pnl_arr < 0]
    sum_losses = float(losses_arr.sum())
    profit_factor = (
        float(wins_arr.sum() / abs(sum_losses)) if sum_losses != 0 else float("inf")
    )
    win_rate = float((pnl_arr > 0).mean())
    if pnl_arr.std() > 0:
        sharpe_units = float(pnl_arr.mean() / pnl_arr.std() * _eval_math.sqrt(n_trades))
    else:
        sharpe_units = 0.0

    return {
        "total_pnl": float(cum[-1]),
        "n_trades": int(n_trades),
        "wins": int(wins_arr.size),
        "losses": int(losses_arr.size),
        "profit_factor": profit_factor,
        "win_rate": win_rate,
        "mean_trade_pnl": float(pnl_arr.mean()),
        "sharpe": sharpe_units,
        "max_drawdown": max_dd_dollars,
        "cum_pnl_dollars": float(cum[-1]),
        "max_drawdown_dollars": max_dd_dollars,
        "max_drawdown_pct": max_dd_pct,
        "sharpe_after_costs": sharpe_units,
        "avg_win_dollars": float(wins_arr.mean()) if wins_arr.size else 0.0,
        "avg_loss_dollars": float(losses_arr.mean()) if losses_arr.size else 0.0,
        "n_long": int((dirs == 1).sum()),
        "n_short": int((dirs == -1).sum()),
        "trade_pnl_dollars": pnl_arr.tolist(),
    }


# ─── Per-fold metrics ────────────────────────────────────────────────────────


def compute_fold_metrics(y_true, y_pred, fold_idx: int) -> dict:
    """Per-fold regression metrics (flat dict).

    Returns
    -------
    dict with keys: mse, mae, r2, rmse, directional_accuracy, pearson_correlation,
    spearman_correlation, pnl_after_costs, sharpe_after_costs.
    Values are floats or None when undefined.
    """
    yt = _eval_to_1d(y_true)
    yp = _eval_to_1d(y_pred)
    if yt.size == 0:
        return {
            "mse": None, "mae": None, "r2": None, "rmse": None,
            "directional_accuracy": None,
            "pearson_correlation": None, "spearman_correlation": None,
            "pnl_after_costs": None, "sharpe_after_costs": None,
        }
    mse = _eval_mse(yt, yp)
    mae = _eval_mae(yt, yp)
    r2 = _eval_r2(yt, yp)
    rmse = _eval_math.sqrt(mse) if mse >= 0 else None
    dir_acc = _eval_directional_accuracy(yt, yp)
    pearson = _eval_pearson(yt, yp)
    spearman = _eval_spearman(yt, yp)
    return {
        "mse": _eval_safe_finite(mse),
        "mae": _eval_safe_finite(mae),
        "r2": _eval_safe_finite(r2),
        "rmse": _eval_safe_finite(rmse),
        "directional_accuracy": _eval_safe_finite(dir_acc),
        "pearson_correlation": _eval_safe_finite(pearson),
        "spearman_correlation": _eval_safe_finite(spearman),
        # PnL is only meaningful when caller passes prices to build_diagnostics
        "pnl_after_costs": None,
        "sharpe_after_costs": None,
    }


# ─── Metric declarations (dashboard schema) ──────────────────────────────────


def _emit_metric_declarations() -> None:
    """Publish regression metric-rendering schema to the dashboard."""
    _eval_emit_decls({
        "mse": {
            "renderer": "number", "group": "error",
            "mission": "Mean squared error. Lower is better.",
            "context": {"min": 0.0, "decimals": 6},
        },
        "rmse": {
            "renderer": "number", "group": "error",
            "mission": "Root mean squared error (target units).",
            "context": {"min": 0.0, "decimals": 6},
        },
        "mae": {
            "renderer": "number", "group": "error",
            "mission": "Mean absolute error. Lower is better.",
            "context": {"min": 0.0, "decimals": 6},
        },
        "r2": {
            "renderer": "gauge", "group": "fit",
            "mission": "Coefficient of determination. 1.0 = perfect; 0 = mean baseline.",
            "context": {"min": -1.0, "baseline": 0.0, "good": 0.1, "great": 0.3, "max": 1.0},
        },
        "directional_accuracy": {
            "renderer": "percent", "group": "fit",
            "mission": "Fraction of bars where sign(pred) matches sign(target).",
            "context": {"baseline": 0.5, "good": 0.55, "great": 0.6},
        },
        "pearson_correlation": {
            "renderer": "number", "group": "fit",
            "mission": "Linear correlation between prediction and target.",
            "context": {"min": -1.0, "max": 1.0, "baseline": 0.0, "decimals": 4},
        },
        "spearman_correlation": {
            "renderer": "number", "group": "fit",
            "mission": "Rank correlation between prediction and target.",
            "context": {"min": -1.0, "max": 1.0, "baseline": 0.0, "decimals": 4},
        },
        "profit_factor": {
            "renderer": "gauge", "group": "pnl",
            "mission": "Sum of wins / |sum of losses| after costs. 1.0 = breakeven.",
            "context": {"min": 0.0, "breakeven": 1.0, "good": 1.5, "great": 2.0},
        },
        "win_rate": {
            "renderer": "percent", "group": "pnl",
            "mission": "Fraction of trades closed for a profit after costs.",
            "context": {"baseline": 0.5, "good": 0.55, "great": 0.6},
        },
        "sharpe_after_costs": {
            "renderer": "number", "group": "pnl",
            "mission": "Sharpe ratio of trade-by-trade PnL after costs (unitless).",
            "context": {"baseline": 0.0, "good": 1.0, "great": 2.0, "decimals": 3},
        },
        "pnl_after_costs": {
            "renderer": "number", "group": "pnl",
            "mission": "Cumulative dollars of trade-by-trade PnL after costs.",
            "context": {"prefix": "$", "decimals": 0},
        },
        "max_drawdown": {
            "renderer": "number", "group": "pnl",
            "mission": "Worst drawdown of cumulative PnL ($).",
            "context": {"prefix": "$", "decimals": 0},
        },
        "n_trades": {
            "renderer": "number", "group": "pnl",
            "mission": "Number of trades taken at the prediction-magnitude threshold.",
            "context": {"min": 0, "good": 50, "decimals": 0},
        },
    })


# ─── Diagnostics dict assembly ────────────────────────────────────────────────


def build_diagnostics(
    model,
    y_true,
    y_pred,
    ts=None,
    prices=None,
    fold_results: list | None = None,
    *,
    model_id: str = "",
    symbol: str = "MNQ",
    timeframe: str = "1m",
    n_train: int = 0,
    n_val: int | None = None,
    n_features: int = 0,
    pnl_threshold: float = 0.0,
    extra: dict | None = None,
) -> dict:
    """Build the regression SelfDescribingDiagnostics dict."""
    yt = _eval_to_1d(y_true)
    yp = _eval_to_1d(y_pred)
    nv = int(yt.size) if n_val is None else int(n_val)

    mse = _eval_mse(yt, yp) if yt.size > 0 else None
    mae = _eval_mae(yt, yp) if yt.size > 0 else None
    r2 = _eval_r2(yt, yp) if yt.size > 0 else None
    rmse = _eval_math.sqrt(mse) if (mse is not None and mse >= 0) else None
    dir_acc = _eval_directional_accuracy(yt, yp) if yt.size > 0 else None
    pearson = _eval_pearson(yt, yp) if yt.size > 0 else None
    spearman = _eval_spearman(yt, yp) if yt.size > 0 else None

    pnl: dict = {}
    if prices is not None:
        try:
            pnl = simulate_pnl_regression(
                yp, prices, ts=ts, threshold=pnl_threshold, symbol=symbol,
            )
        except Exception:
            pnl = {}

    metrics_block = {
        "mse": {"value": _eval_safe_finite(mse), "renderer": "number",
                "group": "error", "mission": "Mean squared error"},
        "rmse": {"value": _eval_safe_finite(rmse), "renderer": "number",
                 "group": "error", "mission": "Root mean squared error"},
        "mae": {"value": _eval_safe_finite(mae), "renderer": "number",
                "group": "error", "mission": "Mean absolute error"},
        "r2": {"value": _eval_safe_finite(r2), "renderer": "gauge",
               "group": "fit", "mission": "R^2 (1.0 = perfect; 0 = mean baseline)"},
        "directional_accuracy": {
            "value": _eval_safe_finite(dir_acc), "renderer": "percent",
            "group": "fit", "mission": "sign(pred) == sign(target)",
        },
        "pearson_correlation": {
            "value": _eval_safe_finite(pearson), "renderer": "number",
            "group": "fit", "mission": "Linear correlation",
        },
        "spearman_correlation": {
            "value": _eval_safe_finite(spearman), "renderer": "number",
            "group": "fit", "mission": "Rank correlation",
        },
    }
    if pnl:
        metrics_block.update({
            "profit_factor": {
                "value": _eval_safe_finite(pnl.get("profit_factor")),
                "renderer": "gauge", "group": "pnl",
                "mission": "Wins / |losses| after costs",
            },
            "sharpe_after_costs": {
                "value": _eval_safe_finite(pnl.get("sharpe_after_costs")),
                "renderer": "number", "group": "pnl",
                "mission": "Trade-by-trade Sharpe after costs",
            },
            "pnl_after_costs": {
                "value": _eval_safe_finite(pnl.get("cum_pnl_dollars")),
                "renderer": "number", "group": "pnl",
                "mission": "Total dollars after costs",
            },
            "max_drawdown": {
                "value": _eval_safe_finite(pnl.get("max_drawdown_dollars")),
                "renderer": "number", "group": "pnl",
                "mission": "Worst drawdown ($)",
            },
            "win_rate": {
                "value": _eval_safe_finite(pnl.get("win_rate")),
                "renderer": "percent", "group": "pnl",
                "mission": "Fraction of trades profitable",
            },
            "n_trades": {
                "value": int(pnl.get("n_trades", 0)),
                "renderer": "number", "group": "pnl",
                "mission": "Number of trades taken",
            },
        })

    diagnostics = {
        "model_id": model_id,
        "symbol": symbol,
        "timeframe": timeframe,
        "n_train": int(n_train),
        "n_val": nv,
        "n_features": int(n_features),
        "task_kind": "regression",
        "metrics": metrics_block,
        "fold_results": fold_results or [],
    }
    if pnl:
        diagnostics["pnl_curve"] = {
            "trade_pnl_dollars": pnl.get("trade_pnl_dollars", []),
            "n_long": int(pnl.get("n_long", 0)),
            "n_short": int(pnl.get("n_short", 0)),
        }
    if extra:
        diagnostics.update(extra)
    return diagnostics


# ─── OOS predictions writer ──────────────────────────────────────────────────


def write_oos_predictions(ts, y_true, y_pred, output_path, *, symbol: str = "MNQ") -> None:
    """Write oos_predictions.parquet with the standard schema.

    Schema: {timestamp, symbol, prediction, confidence}. For regression heads,
    prediction is the real-valued forecast and confidence defaults to 1.0 (no
    intrinsic uncertainty score). Quantile heads can override by writing the
    file directly via polars with the same schema.
    """
    import polars as _eval_pl

    ts_arr = _eval_np.asarray(ts)
    if ts_arr.dtype.kind == "M":
        ts_int = ts_arr.astype("datetime64[s]").astype(_eval_np.int64)
    else:
        ts_int = ts_arr.astype(_eval_np.int64)

    yp = _eval_to_1d(y_pred)
    out = _EvalPath(output_path)
    out.parent.mkdir(parents=True, exist_ok=True)
    _eval_pl.DataFrame({
        "timestamp": ts_int.astype(_eval_np.int64),
        "symbol": [symbol] * int(ts_int.size),
        "prediction": yp.astype(_eval_np.float64),
        "confidence": _eval_np.ones(int(ts_int.size), dtype=_eval_np.float32),
    }).write_parquet(str(out), compression="zstd", compression_level=3)
