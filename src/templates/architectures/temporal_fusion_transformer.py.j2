# Windowed models emit one prediction per window (length N - window_size + 1),
# but the walk-forward / single-fold loop calls compute_fold_metrics(y_test,
# preds) with the FULL-length y_test. Each window's label is its last bar, so
# the windowed preds align to the TAIL of y_test. Wrap the shared metric fn to
# trim y_test to the preds length before comparison (defined after the include
# so this module-scope definition shadows it).
_unaligned_compute_fold_metrics = compute_fold_metrics


def compute_fold_metrics(y_true, y_pred, fold_idx=None):
    yt = np.asarray(y_true)
    n_pred = int(np.asarray(y_pred).shape[0])
    if yt.shape[0] > n_pred:
        yt = yt[-n_pred:]
    return _unaligned_compute_fold_metrics(yt, y_pred, fold_idx)
{% endif %}
