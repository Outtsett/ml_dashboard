{# ---------------------------------------------------------------------- #}
{# transformer_seq.py.j2 — encoder-only transformer (W3.b)                #}
{#                                                                         #}
{# Generic encoder-only transformer over rolling feature-vector windows.  #}
{#                                                                         #}
{# Windowing strategy (same as pytorch_cnn.py.j2):                        #}
{#   The upstream feature matrix is shape (N_bars, F_features). For each  #}
{#   row i with i >= window_size-1 we build the window                    #}
{#       X_window[i] = matrix[i-window_size+1 : i+1, :]   shape (W, F)    #}
{#   so PyTorch sees (B, W, F). We project F → d_model with a Linear,    #}
{#   add sinusoidal positional encoding (PE) on the time axis, run        #}
{#   nn.TransformerEncoder n_layers deep, mean-pool over T, then feed     #}
{#   the (B, d_model) latent to a task-appropriate head.                  #}
{#                                                                         #}
{# Mirrors trading_model/cnn_transformer/model.py without the bespoke     #}
{# two-stream price/volume split — the upstream feature matrix is         #}
{# engineered features, not raw OHLCV, so a single projection is more    #}
{# faithful. The d_model_price + d_model_volume hyperparameters are       #}
{# threaded into a `d_model = d_model_price + d_model_vol` budget for    #}
{# back-compat with the trading_model HPO search space, but both feed the #}
{# same input projection.                                                  #}
{#                                                                         #}
{# Hyperparameters consumed:                                               #}
{#   window_size       (int)                                              #}
{#   d_model_price     (int) — additive part of d_model                   #}
{#   d_model_volume    (int) — additive part of d_model                   #}
{#   d_model           (int) — total embedding dim (overrides if set)     #}
{#   n_layers          (int)                                              #}
{#   n_heads           (int) — must divide d_model                        #}
{#   d_ff              (int) — feedforward dim                            #}
{#   dropout           (float)                                            #}
{#   learning_rate     (float)                                            #}
{#   n_epochs          (int)                                              #}
{#   batch_size        (int)                                              #}
{#   task_kind         (str) — classification | regression                #}
{#   n_classes         (int) — only used for classification               #}
{#   early_stop_patience (int) — defaults to 5                            #}
{#                                                                         #}
{# Imports PositionalEncoding from src.ml.blocks.attention; appropriate   #}
{# task head from src.ml.blocks.head.                                     #}
{# ---------------------------------------------------------------------- #}
{% extends "_base.py.j2" %}

{% set _task_kind = task_kind | default("classification") %}
{% set _n_classes = n_classes | default(2) %}
{% set _window_size = hyperparameters.window_size | default(64) %}
{% set _d_model_price = hyperparameters.d_model_price | default(32) %}
{% set _d_model_vol = hyperparameters.d_model_volume | default(8) %}
{% set _d_model = hyperparameters.d_model | default(_d_model_price + _d_model_vol) %}
{% set _n_layers = hyperparameters.n_layers | default(2) %}
{% set _n_heads = hyperparameters.n_heads | default(4) %}
{% set _d_ff = hyperparameters.d_ff | default(64) %}
{% set _dropout = hyperparameters.dropout | default(0.1) %}
{% set _lr = hyperparameters.learning_rate | default(0.001) %}
{% set _n_epochs = hyperparameters.n_epochs | default(20) %}
{% set _batch_size = hyperparameters.batch_size | default(256) %}
{% set _patience = hyperparameters.early_stop_patience | default(5) %}

