# Static config baked into the rendered template.
_TASK_KIND: str = {{ _task_kind | python_repr }}
_N_CLASSES: int = {{ _n_classes | python_repr }}
_WINDOW_SIZE: int = {{ _window_size | python_repr }}
_CHANNELS: list = {{ _channels | python_repr }}
_KERNEL_SIZES: list = {{ _kernel_sizes | python_repr }}
_DROPOUT: float = {{ _dropout | python_repr }}
_LR: float = {{ _lr | python_repr }}
_N_EPOCHS: int = {{ _n_epochs | python_repr }}
_BATCH_SIZE: int = {{ _batch_size | python_repr }}
_PATIENCE: int = {{ _patience | python_repr }}
_DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Module-level state for per-fold OOS aggregation.
_FOLD_STATE: dict = {"y": [], "preds": [], "ts": []}
_DIAG_DECLARED: dict = {"done": False}


def _build_windows(X: np.ndarray, y: np.ndarray):
    """Build rolling windows of length ``_WINDOW_SIZE`` across the bar axis.

    Inputs:
        X : (N_bars, F_features) flat feature matrix
        y : (N_bars,) labels per bar
    Outputs:
        Xw : (N_bars - W + 1, F, W) — channel-first for Conv1D
        yw : (N_bars - W + 1,)      — aligned to the window's last bar
    """
    arr = np.asarray(X)
    yarr = np.asarray(y)
    n_bars = int(arr.shape[0])
    if n_bars < _WINDOW_SIZE:
        return (
            np.zeros((0, arr.shape[1], _WINDOW_SIZE), dtype=np.float32),
            np.zeros((0,), dtype=yarr.dtype),
        )
    windows = np.lib.stride_tricks.sliding_window_view(
        arr, window_shape=_WINDOW_SIZE, axis=0
    )
    Xw = np.ascontiguousarray(windows).astype(np.float32)
    yw = yarr[_WINDOW_SIZE - 1:]
    return Xw, yw


class _CNNModel(nn.Module):
    """Conv1DEncoder body + global-pool + task head.

    Conv1DEncoder accepts (B, C_in, T) and returns (B, C_out, T').
    We collapse the temporal axis with global average pooling, then feed
    the (B, C_out) latent to a task-appropriate head.
    """

    def __init__(self, in_channels: int):
        super().__init__()
        self.encoder = Conv1DEncoder(
            in_channels=in_channels,
            channels=_CHANNELS,
            kernel_sizes=_KERNEL_SIZES,
            dropout=_DROPOUT,
        )
        latent_dim = int(_CHANNELS[-1])
        {% if _task_kind == "regression" %}
        self.head = RegressionHead(d_model=latent_dim, n_targets=1)
        {% elif _n_classes == 2 %}
        self.head = BinaryDirectionHead(d_model=latent_dim)
        {% else %}
        self.head = ClassificationHead(d_model=latent_dim, n_classes=_N_CLASSES)
        {% endif %}

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        feat = self.encoder(x)
        if feat.dim() == 3:
            pooled = feat.mean(dim=-1)
        else:
            pooled = feat
        return self.head(pooled)
{% endblock %}

{% block train_loop %}
def _make_loaders(X_train, y_train, X_test, y_test):
    Xw_tr, yw_tr = _build_windows(X_train, y_train)
    Xw_te, yw_te = _build_windows(X_test, y_test)
    X_tr = torch.as_tensor(Xw_tr, dtype=torch.float32)
    X_te = torch.as_tensor(Xw_te, dtype=torch.float32)
    {% if _task_kind == "regression" %}
    y_tr = torch.as_tensor(yw_tr, dtype=torch.float32).reshape(-1, 1)
    y_te = torch.as_tensor(yw_te, dtype=torch.float32).reshape(-1, 1)
    {% else %}
    y_tr = torch.as_tensor(yw_tr, dtype=torch.long).reshape(-1)
    y_te = torch.as_tensor(yw_te, dtype=torch.long).reshape(-1)
    {% endif %}
    train_ds = TensorDataset(X_tr, y_tr)
    val_ds = TensorDataset(X_te, y_te)
    train_loader = DataLoader(
        train_ds, batch_size=_BATCH_SIZE, shuffle=True,
        num_workers=0, pin_memory=(_DEVICE.type == "cuda"),
    )
    val_loader = DataLoader(
        val_ds, batch_size=_BATCH_SIZE, shuffle=False,
        num_workers=0, pin_memory=(_DEVICE.type == "cuda"),
    )
    return train_loader, val_loader, yw_te


def _loss_fn(logits: torch.Tensor, y: torch.Tensor) -> torch.Tensor:
    {% if _task_kind == "regression" %}
    return F.mse_loss(logits.reshape(-1), y.reshape(-1))
    {% elif _n_classes == 2 %}
    return F.binary_cross_entropy_with_logits(logits.reshape(-1), y.reshape(-1).float())
    {% else %}
    return F.cross_entropy(logits, y.reshape(-1))
    {% endif %}


def _logits_to_preds(logits: torch.Tensor) -> np.ndarray:
    {% if _task_kind == "regression" %}
    return logits.detach().cpu().numpy().reshape(-1).astype(np.float64)
    {% elif _n_classes == 2 %}
    return torch.sigmoid(logits.reshape(-1)).detach().cpu().numpy().astype(np.float64)
    {% else %}
    return F.softmax(logits, dim=-1).detach().cpu().numpy().astype(np.float64)
    {% endif %}


def train_one_fold(X_train, y_train, X_test, y_test, args, *, fold_idx=None, ts_test=None):
    """1D CNN + AdamW + early-stop. Returns (model, preds_aligned_to_y_test).

    Note: predictions are per WINDOW (one per row of X_test starting from index
    W-1).
    """
    fold_tag = "single" if fold_idx is None else str(fold_idx)
    in_channels = int(X_train.shape[1])
    model = _CNNModel(in_channels=in_channels).to(_DEVICE)
    optimizer = torch.optim.AdamW(model.parameters(), lr=_LR, weight_decay=1e-4)
    train_loader, val_loader, yw_te = _make_loaders(X_train, y_train, X_test, y_test)

    if len(train_loader) == 0:
        emit_log(
            f"[cnn][fold={fold_tag}] insufficient bars for window_size={_WINDOW_SIZE}; "
            f"skipping training and emitting empty preds."
        )
        empty = np.zeros(int(np.asarray(y_test).shape[0]), dtype=np.float64)
        _FOLD_STATE["y"].append(np.asarray(y_test))
        _FOLD_STATE["preds"].append(empty)
        if ts_test is not None:
            _FOLD_STATE["ts"].append(np.asarray(ts_test))
        return model, empty

    best_val_loss = float("inf")
    best_state: dict | None = None
    epochs_no_improve = 0

    if not _DIAG_DECLARED["done"]:
        declare_diagnostics_metrics()
        _DIAG_DECLARED["done"] = True
    if _DEVICE.type == "cuda":
        torch.cuda.reset_peak_memory_stats()

    for epoch in range(_N_EPOCHS):
        model.train()
        t0 = time.perf_counter()
        train_loss_sum = 0.0
        n_train_samples = 0
        grad_norm_sum = 0.0
        n_batches = 0
        for xb, yb in train_loader:
            xb = xb.to(_DEVICE, non_blocking=True)
            yb = yb.to(_DEVICE, non_blocking=True)
            optimizer.zero_grad(set_to_none=True)
            logits = model(xb)
            loss = _loss_fn(logits, yb)
            loss.backward()
            grad_norm_sum += global_grad_norm(model)
            n_batches += 1
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()
            train_loss_sum += float(loss.item()) * xb.size(0)
            n_train_samples += xb.size(0)
        epoch_dt = max(1e-6, time.perf_counter() - t0)
        train_loss = train_loss_sum / max(1, n_train_samples)

        model.eval()
        val_loss_sum = 0.0
        n_val_samples = 0
        with torch.no_grad():
            for xb, yb in val_loader:
                xb = xb.to(_DEVICE, non_blocking=True)
                yb = yb.to(_DEVICE, non_blocking=True)
                logits = model(xb)
                vloss = _loss_fn(logits, yb)
                val_loss_sum += float(vloss.item()) * xb.size(0)
                n_val_samples += xb.size(0)
        val_loss = val_loss_sum / max(1, n_val_samples)

        emit_metric(name=f"fold_{fold_tag}_train_loss", value=float(train_loss), iteration=epoch)
        emit_metric(name=f"fold_{fold_tag}_val_loss", value=float(val_loss), iteration=epoch)
        emit_step_diagnostics(
            step=epoch, total=_N_EPOCHS,
            grad_norm=grad_norm_sum / max(1, n_batches),
            lr=current_lr(optimizer),
            throughput=n_train_samples / epoch_dt,
            vram=vram_mb(),
        )
        emit_log(
            f"[cnn][fold={fold_tag}] epoch {epoch+1}/{_N_EPOCHS} "
            f"train_loss={train_loss:.6f} val_loss={val_loss:.6f}"
        )

        if val_loss + 1e-9 < best_val_loss:
            best_val_loss = val_loss
            best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}
            epochs_no_improve = 0
        else:
            epochs_no_improve += 1
            if epochs_no_improve >= _PATIENCE:
                emit_log(
                    f"[cnn][fold={fold_tag}] early stop at epoch {epoch+1}"
                )
                break

    if best_state is not None:
        model.load_state_dict(best_state)

    model.eval()
    preds_chunks: list[np.ndarray] = []
    with torch.no_grad():
        for xb, _yb in val_loader:
            xb = xb.to(_DEVICE, non_blocking=True)
            logits = model(xb)
            preds_chunks.append(_logits_to_preds(logits))
    if preds_chunks:
        preds = np.concatenate(preds_chunks, axis=0)
    else:
        preds = np.asarray([], dtype=np.float64)

    _FOLD_STATE["y"].append(np.asarray(yw_te))
    _FOLD_STATE["preds"].append(preds)
    if ts_test is not None:
        ts_arr = np.asarray(ts_test)
        # Windowed prediction i corresponds to the window ending at row
        # (window_size - 1 + i) of this fold's test set — tail-align the
        # timestamps identically to how _build_windows tail-aligns yw_te.
        _FOLD_STATE["ts"].append(ts_arr[_WINDOW_SIZE - 1:] if ts_arr.size >= _WINDOW_SIZE else ts_arr[:0])
    return model, preds


def predict(model, X) -> np.ndarray:
    """Standard predict contract. X is the raw (N_bars, F) feature matrix;
    we build rolling windows internally and return preds for each window
    (length = N_bars - window_size + 1)."""
    model.eval()
    arr = np.asarray(X)
    if arr.shape[0] < _WINDOW_SIZE:
        return np.asarray([], dtype=np.float64)
    Xw = np.lib.stride_tricks.sliding_window_view(
        arr, window_shape=_WINDOW_SIZE, axis=0
    )
    Xw = np.ascontiguousarray(Xw).astype(np.float32)
    X_t = torch.as_tensor(Xw, dtype=torch.float32)
    out_chunks: list[np.ndarray] = []
    with torch.no_grad():
        for i in range(0, X_t.shape[0], _BATCH_SIZE):
            chunk = X_t[i:i + _BATCH_SIZE].to(_DEVICE, non_blocking=True)
            logits = model(chunk)
            out_chunks.append(_logits_to_preds(logits))
    if out_chunks:
        return np.concatenate(out_chunks, axis=0)
    return np.asarray([], dtype=np.float64)
