# Windowed CNN emits one prediction per window (N - window_size + 1), but the
# single-fold / walk-forward loop calls compute_fold_metrics(y_test, preds) with
# the FULL y_test. Align y_test to the windowed preds' tail (defined after the
# include so it shadows the shared definition).
_unaligned_compute_fold_metrics = compute_fold_metrics


def compute_fold_metrics(y_true, y_pred, fold_idx=None):
    yt = np.asarray(y_true)
    n_pred = int(np.asarray(y_pred).shape[0])
    if yt.shape[0] > n_pred:
        yt = yt[-n_pred:]
    return _unaligned_compute_fold_metrics(yt, y_pred, fold_idx)
