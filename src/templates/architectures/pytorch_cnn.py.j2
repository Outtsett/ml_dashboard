{# ---------------------------------------------------------------------- #}
{# pytorch_cnn.py.j2 — 1D CNN over rolling windows (W3.b)                 #}
{#                                                                         #}
{# Windowing strategy:                                                     #}
{#   The upstream feature matrix is shape (N_bars, F_features) — one row   #}
{#   per bar with all engineered features for that bar.                    #}
{#   For each row i with i >= window_size-1 we build the window            #}
{#   X_window[i] = matrix[i-window_size+1 : i+1, :]   shape (window, F)    #}
{#   then transpose to (F, window) so PyTorch Conv1D sees                  #}
{#   (B, C=F, T=window). The first (window_size-1) rows are dropped on     #}
{#   both X and y (no full history available).                             #}
{#                                                                         #}
{# Hyperparameters consumed:                                               #}
{#   window_size          (int)        — number of bars per Conv1D input  #}
{#   channels             (list[int])  — Conv1D output channel sequence   #}
{#                                       (e.g. [16, 32]) — Conv1DEncoder  #}
{#                                       expects this list                 #}
{#   kernel_sizes         (list[int])  — kernel size per conv layer       #}
{#   dropout              (float)                                         #}
{#   learning_rate        (float)                                         #}
{#   n_epochs             (int)                                           #}
{#   batch_size           (int)                                           #}
{#   task_kind            (str)        — "classification" | "regression"  #}
{#   n_classes            (int)        — only used for classification     #}
{#   early_stop_patience  (int)        — defaults to 5                    #}
{#                                                                         #}
{# Imports Conv1DEncoder + appropriate head from src.ml.blocks.            #}
{# ---------------------------------------------------------------------- #}
{% extends "_base.py.j2" %}

{% set _task_kind = task_kind | default("classification") %}
{% set _n_classes = n_classes | default(2) %}
{% set _window_size = hyperparameters.window_size | default(64) %}
{% set _channels = hyperparameters.channels | default([16, 32]) %}
{% set _kernel_sizes = hyperparameters.kernel_sizes | default([5, 3]) %}
{% set _dropout = hyperparameters.dropout | default(0.1) %}
{% set _lr = hyperparameters.learning_rate | default(0.001) %}
{% set _n_epochs = hyperparameters.n_epochs | default(20) %}
{% set _batch_size = hyperparameters.batch_size | default(256) %}
{% set _patience = hyperparameters.early_stop_patience | default(5) %}

