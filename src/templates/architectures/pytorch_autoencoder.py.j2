            "timestamp": np.arange(all_scores.size, dtype=np.int64),
            "symbol": [args.symbol] * int(all_scores.size),
            "prediction": all_scores.astype(np.float64),
            "confidence": np.ones(int(all_scores.size), dtype=np.float32),
        }).write_parquet(str(out_path), compression="zstd", compression_level=3)
