{# ---------------------------------------------------------------------- #}
{# pytorch_autoencoder.py.j2 — symmetric AE with bottleneck (W3.b)        #}
{#                                                                         #}
{# Unsupervised reconstruction model. Input flat feature vector x is       #}
{# encoded to a `latent_dim` bottleneck via MLPEncoder, then decoded back  #}
{# to the input space via MLPDecoder. Loss = MSE(x, x_recon).              #}
{#                                                                         #}
{# Per-sample reconstruction error is the model's anomaly score: higher   #}
{# error = more anomalous. The standard predict() returns this scalar.     #}
{#                                                                         #}
{# Hyperparameters consumed (via ctx.hyperparameters):                     #}
{#   hidden_dims          (list[int])  — encoder layer widths              #}
{#                                       (decoder mirrors in reverse)      #}
{#   latent_dim           (int)        — bottleneck width                  #}
{#   dropout              (float)                                          #}
{#   learning_rate        (float)                                          #}
{#   n_epochs             (int)                                            #}
{#   batch_size           (int)                                            #}
{#   early_stop_patience  (int)                                            #}
{#                                                                         #}
{# OOS predictions schema (oos_predictions.parquet):                       #}
{#   prediction = anomaly_score  (per-sample reconstruction MSE)           #}
{#   confidence = 1.0            (anomaly score has no intrinsic 0-1 conf) #}
{# ---------------------------------------------------------------------- #}
{% extends "_base.py.j2" %}

{% set _hidden_dims = hyperparameters.hidden_dims | default([128, 64]) %}
{% set _latent_dim = hyperparameters.latent_dim | default(16) %}
{% set _dropout = hyperparameters.dropout | default(0.1) %}
{% set _lr = hyperparameters.learning_rate | default(0.001) %}
{% set _n_epochs = hyperparameters.n_epochs | default(20) %}
{% set _batch_size = hyperparameters.batch_size | default(256) %}
{% set _patience = hyperparameters.early_stop_patience | default(5) %}

{# NOTE: `time` is already imported by _base.py.j2 — re-importing here is a #}
{# redefinition (F811) in the rendered module.                              #}
{% block model_imports %}
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, TensorDataset

from src.ml.blocks import MLPEncoder, MLPDecoder
from src.ml.shared.torch_logging import (
    declare_diagnostics_metrics, emit_step_diagnostics,
    global_grad_norm, current_lr, vram_mb,
)

# Static config baked into the rendered template.
_HIDDEN_DIMS: list = {{ _hidden_dims | python_repr }}
_LATENT_DIM: int = {{ _latent_dim | python_repr }}
_DROPOUT: float = {{ _dropout | python_repr }}
_LR: float = {{ _lr | python_repr }}
_N_EPOCHS: int = {{ _n_epochs | python_repr }}
_BATCH_SIZE: int = {{ _batch_size | python_repr }}
_PATIENCE: int = {{ _patience | python_repr }}
_DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Module-level state for per-fold OOS aggregation.
_FOLD_STATE: dict = {"recon_err": [], "n_input": []}
_DIAG_DECLARED: dict = {"done": False}


class _AEModel(nn.Module):
    """MLPEncoder → bottleneck Linear → MLPDecoder. Symmetric architecture.

    encoder : MLPEncoder(input_dim, hidden_dims, dropout)  → (B, hidden_dims[-1])
    bridge  : Linear(hidden_dims[-1], latent_dim)          → (B, latent_dim)
    decoder : MLPDecoder(latent_dim, reversed_hidden_dims, dropout, output_dim=input_dim)
    """

    def __init__(self, input_dim: int):
        super().__init__()
        self.input_dim = input_dim
        self.encoder = MLPEncoder(
            input_dim=input_dim,
            hidden_dims=_HIDDEN_DIMS,
            dropout=_DROPOUT,
        )
        self.to_latent = nn.Linear(int(_HIDDEN_DIMS[-1]), int(_LATENT_DIM))
        # Mirror the encoder dims in reverse for the decoder body.
        self.decoder = MLPDecoder(
            latent_dim=int(_LATENT_DIM),
            hidden_dims=list(reversed(_HIDDEN_DIMS)),
            output_dim=input_dim,
            dropout=_DROPOUT,
        )

    def encode(self, x: torch.Tensor) -> torch.Tensor:
        h = self.encoder(x)
        return self.to_latent(h)

    def decode(self, z: torch.Tensor) -> torch.Tensor:
        return self.decoder(z)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        z = self.encode(x)
        return self.decode(z)
{% endblock %}

{% block label_generation %}
def generate_labels(raw, args):
    """Autoencoder is unsupervised — return placeholder zeros + all-True mask.

    The walk-forward loop still threads y through; its values are ignored by
    train_one_fold below.
    """
    n = int(raw["close"].shape[0])
    return np.zeros(n, dtype=np.float32), np.ones(n, dtype=bool)
{% endblock %}

{% block train_loop %}
def _make_loaders(X_train, X_test):
    X_tr = torch.as_tensor(np.asarray(X_train), dtype=torch.float32)
    X_te = torch.as_tensor(np.asarray(X_test), dtype=torch.float32)
    train_ds = TensorDataset(X_tr)
    val_ds = TensorDataset(X_te)
    train_loader = DataLoader(
        train_ds, batch_size=_BATCH_SIZE, shuffle=True,
        num_workers=0, pin_memory=(_DEVICE.type == "cuda"),
    )
    val_loader = DataLoader(
        val_ds, batch_size=_BATCH_SIZE, shuffle=False,
        num_workers=0, pin_memory=(_DEVICE.type == "cuda"),
    )
    return train_loader, val_loader


def train_one_fold(X_train, y_train, X_test, y_test, args, *, fold_idx=None):
    """AE + AdamW + early-stop on val MSE. Returns (model, anomaly_scores)."""
    fold_tag = "single" if fold_idx is None else str(fold_idx)
    input_dim = int(X_train.shape[1])
    model = _AEModel(input_dim=input_dim).to(_DEVICE)
    optimizer = torch.optim.AdamW(model.parameters(), lr=_LR, weight_decay=1e-4)
    train_loader, val_loader = _make_loaders(X_train, X_test)

    best_val_loss = float("inf")
    best_state: dict | None = None
    epochs_no_improve = 0

    if not _DIAG_DECLARED["done"]:
        declare_diagnostics_metrics()
        _DIAG_DECLARED["done"] = True
    if _DEVICE.type == "cuda":
        torch.cuda.reset_peak_memory_stats()

    for epoch in range(_N_EPOCHS):
        model.train()
        t0 = time.perf_counter()
        train_loss_sum = 0.0
        n_train_samples = 0
        grad_norm_sum = 0.0
        n_batches = 0
        for (xb,) in train_loader:
            xb = xb.to(_DEVICE, non_blocking=True)
            optimizer.zero_grad(set_to_none=True)
            recon = model(xb)
            loss = F.mse_loss(recon, xb)
            loss.backward()
            grad_norm_sum += global_grad_norm(model)
            n_batches += 1
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()
            train_loss_sum += float(loss.item()) * xb.size(0)
            n_train_samples += xb.size(0)
        epoch_dt = max(1e-6, time.perf_counter() - t0)
        train_loss = train_loss_sum / max(1, n_train_samples)

        model.eval()
        val_loss_sum = 0.0
        n_val_samples = 0
        with torch.no_grad():
            for (xb,) in val_loader:
                xb = xb.to(_DEVICE, non_blocking=True)
                recon = model(xb)
                vloss = F.mse_loss(recon, xb)
                val_loss_sum += float(vloss.item()) * xb.size(0)
                n_val_samples += xb.size(0)
        val_loss = val_loss_sum / max(1, n_val_samples)

        emit_metric(name=f"fold_{fold_tag}_train_recon_mse", value=float(train_loss), iteration=epoch)
        emit_metric(name=f"fold_{fold_tag}_val_recon_mse", value=float(val_loss), iteration=epoch)
        emit_step_diagnostics(
            step=epoch, total=_N_EPOCHS,
            grad_norm=grad_norm_sum / max(1, n_batches),
            lr=current_lr(optimizer),
            throughput=n_train_samples / epoch_dt,
            vram=vram_mb(),
        )
        emit_log(
            f"[ae][fold={fold_tag}] epoch {epoch+1}/{_N_EPOCHS} "
            f"train_mse={train_loss:.6f} val_mse={val_loss:.6f}"
        )

        if val_loss + 1e-9 < best_val_loss:
            best_val_loss = val_loss
            best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}
            epochs_no_improve = 0
        else:
            epochs_no_improve += 1
            if epochs_no_improve >= _PATIENCE:
                emit_log(
                    f"[ae][fold={fold_tag}] early stop at epoch {epoch+1}"
                )
                break

    if best_state is not None:
        model.load_state_dict(best_state)

    # Per-sample reconstruction error on the val set = anomaly score.
    model.eval()
    err_chunks: list[np.ndarray] = []
    with torch.no_grad():
        for (xb,) in val_loader:
            xb = xb.to(_DEVICE, non_blocking=True)
            recon = model(xb)
            per_sample = ((recon - xb) ** 2).mean(dim=1)
            err_chunks.append(per_sample.detach().cpu().numpy().astype(np.float64))
    if err_chunks:
        scores = np.concatenate(err_chunks, axis=0)
    else:
        scores = np.asarray([], dtype=np.float64)

    _FOLD_STATE["recon_err"].append(scores)
    _FOLD_STATE["n_input"].append(int(input_dim))
    return model, scores


def predict(model, X) -> np.ndarray:
    """Standard predict contract. Returns per-sample reconstruction MSE
    (anomaly score). Higher = more anomalous."""
    model.eval()
    X_t = torch.as_tensor(np.asarray(X), dtype=torch.float32)
    err_chunks: list[np.ndarray] = []
    with torch.no_grad():
        for i in range(0, X_t.shape[0], _BATCH_SIZE):
            chunk = X_t[i:i + _BATCH_SIZE].to(_DEVICE, non_blocking=True)
            recon = model(chunk)
            per_sample = ((recon - chunk) ** 2).mean(dim=1)
            err_chunks.append(per_sample.detach().cpu().numpy().astype(np.float64))
    if err_chunks:
        return np.concatenate(err_chunks, axis=0)
    return np.asarray([], dtype=np.float64)
{% endblock %}

{% block compute_fold_metrics %}
def compute_fold_metrics(y_test, preds, *, fold_idx=None) -> dict[str, float]:
    """Anomaly-score summary stats for the AE. y_test is the unused label
    placeholder from generate_labels."""
    arr = np.asarray(preds, dtype=np.float64)
    if arr.size == 0:
        return {"n_samples": 0.0, "mean_recon_mse": 0.0, "median_recon_mse": 0.0,
                "p95_recon_mse": 0.0, "p99_recon_mse": 0.0, "max_recon_mse": 0.0}
    return {
        "n_samples": float(arr.size),
        "mean_recon_mse": float(arr.mean()),
        "median_recon_mse": float(np.median(arr)),
        "p95_recon_mse": float(np.quantile(arr, 0.95)),
        "p99_recon_mse": float(np.quantile(arr, 0.99)),
        "max_recon_mse": float(arr.max()),
    }
{% endblock %}

{% block eval_block %}
    # ─── W3.b autoencoder rollup ─────────────────────────────────────────
    if _FOLD_STATE["recon_err"]:
        all_scores = np.concatenate(_FOLD_STATE["recon_err"]).astype(np.float64)
    else:
