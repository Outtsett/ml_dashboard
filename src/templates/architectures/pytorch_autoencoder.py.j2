                "value": float(np.quantile(all_scores, 0.95)) if all_scores.size else 0.0,
                "renderer": "number", "group": "reconstruction",
                "mission": "95th percentile per-sample reconstruction MSE — anomaly band threshold.",
            },
            "n_val_samples": {
                "value": int(all_scores.size),
                "renderer": "number", "group": "reconstruction",
                "mission": "Number of OOS samples scored.",
