{
  "version": 1,
  "models": {
    "hdp-hmm": {
      "name": "HDP-HMM",
      "category": "unsupervised",
      "subcategory": "clustering",
      "runner": "python",
      "script": "scripts/train-hdp-hmm.py",
      "outputs": ["regimes", "diagnostics", "convergence"],
      "chartOverlay": "regime_colors",
      "outputDir": "data/models/hdp-hmm",
      "requiresDataExport": false,
      "defaultHyperparameters": {
        "gibbsIter": { "value": 200, "min": 20, "max": 1000, "step": 10, "label": "Gibbs Iterations" },
        "burnIn": { "value": 50, "min": 5, "max": 400, "step": 5, "label": "Burn-in" },
        "testSplit": { "value": 0.15, "min": 0.05, "max": 0.40, "step": 0.05, "label": "Test Split" },
        "wfWindows": { "value": 5, "min": 2, "max": 10, "step": 1, "label": "Walk-Forward Windows" },
        "alpha": { "value": 1.0, "min": 0.01, "max": 10.0, "step": 0.1, "label": "Alpha (transition concentration)" },
        "gamma": { "value": 10.0, "min": 0.1, "max": 100.0, "step": 0.5, "label": "Gamma (DP concentration — higher = more regimes)" },
        "kappa": { "value": 50.0, "min": 1.0, "max": 200.0, "step": 5.0, "label": "Kappa (stickiness)" }
      }
    }
  }
}
