{
  "version": "2.0.0",
  "metadata": {
    "organization": "Institutional Quant",
    "last_audit": "2026-05-08",
    "notes": "Populated 2026-05-08 for ML Studio P3. PythonRunner accepts absolute paths for `script` and `outputDir` (patched in src/server/training/runners/pythonRunner.ts). Sibling-repo HPO drivers are reached via thin wrappers in scripts/wrap-*.py that translate the orchestrator CLI contract."
  },
  "models": {
    "xgb_classifier": {
      "name": "XGBoost Direction Classifier",
      "category": "Supervised",
      "subcategory": "Gradient Boosting",
      "runner": "python",
      "script": "src/ml/xgb_classifier/main.py",
      "outputDir": "data/models",
      "featurePipeline": "default-35",
      "chartOverlay": "prediction_heatband",
      "outputs": [
        "checkpoint.json",
        "model.ubj",
        "diagnostics.json",
        "oos_predictions.parquet",
        "shap_summary.npz"
      ],
      "family": "gradient_boosting",
      "gpuRequired": true,
      "estimatedTrainingTime": "1-5 min",
      "tags": ["classification", "direction", "triple-barrier", "calibrated"],
      "description": "Binary direction classifier with triple-barrier labels (López de Prado), GPU histogram boosting, calibration + ECE, cost-adjusted PnL simulation, SHAP feature attribution.",
      "supportedObjectives": ["sharpe_after_costs", "profit_factor", "auc", "log_loss"],
      "featureCategories": [
        "price_action",
        "volatility",
        "volume",
        "momentum"
      ],
      "includeIndicators": false,
      "allFeatures": false,
      "defaultHyperparameters": {
        "n_estimators":          { "type": "int",   "default": 500,  "min": 50,    "max": 5000,  "label": "Boosting rounds",       "group": "Architecture" },
        "max_depth":             { "type": "int",   "default": 6,    "min": 2,     "max": 12,    "label": "Tree depth",            "group": "Architecture" },
        "learning_rate":         { "type": "float", "default": 0.05, "min": 0.005, "max": 0.3,   "label": "Learning rate",         "group": "Optimization", "logScale": true, "step": 0.005 },
        "subsample":             { "type": "float", "default": 0.8,  "min": 0.5,   "max": 1.0,   "label": "Row subsample",         "group": "Regularization", "step": 0.05 },
        "colsample_bytree":      { "type": "float", "default": 0.8,  "min": 0.5,   "max": 1.0,   "label": "Feature subsample",     "group": "Regularization", "step": 0.05 },
        "min_child_weight":      { "type": "float", "default": 1.0,  "min": 0.1,   "max": 10.0,  "label": "Min child weight",      "group": "Regularization", "logScale": true },
        "reg_lambda":            { "type": "float", "default": 1.0,  "min": 0.0,   "max": 10.0,  "label": "L2 regularization",     "group": "Regularization" },
        "reg_alpha":             { "type": "float", "default": 0.0,  "min": 0.0,   "max": 5.0,   "label": "L1 regularization",     "group": "Regularization" },
        "early_stopping_rounds": { "type": "int",   "default": 50,   "min": 10,    "max": 500,   "label": "Early stopping rounds", "group": "Optimization" },
        "label_horizon_bars":    { "type": "int",   "default": 5,    "min": 1,     "max": 50,    "label": "Label horizon (bars)",  "group": "Labeling" },
        "label_threshold_bp":    { "type": "float", "default": 5.0,  "min": 0.5,   "max": 50.0,  "label": "Label threshold (bp)",  "group": "Labeling", "step": 0.5 }
      },
      "cliFlags": {
        "n_estimators":          "--n-estimators",
        "max_depth":             "--max-depth",
        "learning_rate":         "--learning-rate",
        "subsample":             "--subsample",
        "colsample_bytree":      "--colsample-bytree",
        "min_child_weight":      "--min-child-weight",
        "reg_lambda":            "--reg-lambda",
        "reg_alpha":             "--reg-alpha",
        "early_stopping_rounds": "--early-stopping-rounds",
        "label_horizon_bars":    "--label-horizon-bars",
        "label_threshold_bp":    "--label-threshold-bp"
      },
      "defaultSearchSpace": {
        "max_depth":          { "type": "int",   "low": 3,    "high": 10 },
        "learning_rate":      { "type": "float", "low": 0.01, "high": 0.3,  "log": true },
        "subsample":          { "type": "float", "low": 0.6,  "high": 1.0 },
        "colsample_bytree":   { "type": "float", "low": 0.6,  "high": 1.0 },
        "min_child_weight":   { "type": "float", "low": 0.5,  "high": 10.0, "log": true },
        "reg_lambda":         { "type": "float", "low": 0.0,  "high": 10.0 },
        "reg_alpha":          { "type": "float", "low": 0.0,  "high": 5.0 },
        "label_horizon_bars": { "type": "int",   "low": 3,    "high": 30 },
        "label_threshold_bp": { "type": "float", "low": 2.0,  "high": 30.0 }
      }
    },

    "primitives": {
      "name": "Primitives Discovery",
      "category": "neural-network",
      "subcategory": "Hybrid Architectures",
      "runner": "python",
      "script": "E:\\source\\repos\\primitives_discovery\\src\\ml\\primitives_discovery\\main.py",
      "featurePipeline": "self-contained",
      "outputs": ["checkpoint", "diagnostics", "predictions"],
      "chartOverlay": "prediction_markers",
      "outputDir": "data/models",
      "tags": ["transformer", "feature-attention", "self-discovering"],
      "family": "transformer",
      "gpuRequired": true,
      "estimatedTrainingTime": "5-30 min per run",
      "supportedObjectives": ["minimize_loss", "maximize_roc_auc"],
      "description": "Feature-Attention CNN+Transformer that discovers trading signals from ~510 mathematical primitives over raw OHLCV. Three output heads: direction, magnitude, confidence.",
      "defaultHyperparameters": {
        "epochs":             { "type": "int",   "default": 100,    "min": 1,       "max": 1000,  "step": 1,       "label": "Epochs",               "group": "Training",       "description": "Maximum training epochs (early stopping may end sooner)." },
        "batch_size":         { "type": "int",   "default": 64,     "min": 8,       "max": 1024,  "step": 8,       "label": "Batch size",           "group": "Training" },
        "learning_rate":      { "type": "float", "default": 0.0003, "min": 0.00001, "max": 0.01,  "step": 0.00001, "label": "Learning rate",        "group": "Training",       "logScale": true },
        "patience":           { "type": "int",   "default": 15,     "min": 1,       "max": 100,   "step": 1,       "label": "Early-stop patience",  "group": "Training" },
        "window_size":        { "type": "int",   "default": 64,     "min": 16,      "max": 256,   "step": 8,       "label": "Window size (bars)",   "group": "Architecture" },
        "d_model":            { "type": "int",   "default": 256,    "min": 32,      "max": 1024,  "step": 32,      "label": "d_model",              "group": "Architecture" },
        "n_heads":            { "type": "int",   "default": 8,      "min": 1,       "max": 16,    "step": 1,       "label": "Attention heads",      "group": "Architecture" },
        "n_layers":           { "type": "int",   "default": 4,      "min": 1,       "max": 12,    "step": 1,       "label": "Transformer layers",   "group": "Architecture" },
        "forward_n":          { "type": "int",   "default": 5,      "min": 1,       "max": 60,    "step": 1,       "label": "Forward horizon (bars)","group": "Labels",         "description": "Bars ahead used to compute the forward return label." },
        "test_split":         { "type": "float", "default": 0.2,    "min": 0.05,    "max": 0.5,   "step": 0.05,    "label": "Test split",           "group": "Validation" },
        "primitive_lookback": { "type": "int",   "default": 20,     "min": 5,       "max": 200,   "step": 1,       "label": "Primitive lookback",   "group": "Features",       "description": "Rolling z-score lookback for primitive normalization." }
      },
      "cliFlags": {
        "epochs":             "--epochs",
        "batch_size":         "--batch-size",
        "learning_rate":      "--learning-rate",
        "patience":           "--patience",
        "window_size":        "--window-size",
        "d_model":            "--d-model",
        "n_heads":            "--n-heads",
        "n_layers":           "--n-layers",
        "forward_n":          "--forward-n",
        "test_split":         "--test-split",
        "primitive_lookback": "--primitive-lookback"
      }
    },

    "transformer_range": {
      "name": "Range-Bucket Transformer (HPO)",
      "category": "neural-network",
      "subcategory": "Time-Series Transformers",
      "runner": "python",
      "script": "scripts/wrap-transformer-range.py",
      "featurePipeline": "self-contained",
      "outputs": ["hpo_results", "best_checkpoint", "diagnostics"],
      "chartOverlay": "prediction_markers",
      "outputDir": "data/models",
      "tags": ["transformer", "hpo", "range-classification"],
      "family": "transformer",
      "gpuRequired": true,
      "estimatedTrainingTime": "10-60 min per study",
      "supportedObjectives": ["maximize_within2pt_acc", "maximize_cost_adj_sharpe"],
      "description": "Two-stream Transformer (price + volume) with range-bucket classification head. K-class softmax over next-N-bar range buckets. Optuna TPE sweep with walk-forward evaluation. Wrapper at scripts/wrap-transformer-range.py adapts trading_model HPO CLI to the orchestrator contract.",
      "defaultHyperparameters": {
        "n_trials":        { "type": "int",   "default": 10,  "min": 1,    "max": 200,  "step": 1,    "label": "Optuna trials",                  "group": "HPO" },
        "epochs":          { "type": "int",   "default": 8,   "min": 1,    "max": 200,  "step": 1,    "label": "Epochs per trial",               "group": "Training" },
        "n_folds":         { "type": "int",   "default": 0,   "min": 0,    "max": 12,   "step": 1,    "label": "Walk-forward folds (0 = single split)", "group": "Validation" },
        "fold_months":     { "type": "int",   "default": 6,   "min": 1,    "max": 36,   "step": 1,    "label": "Fold size (months)",             "group": "Validation" },
        "purge_bars":      { "type": "int",   "default": 120, "min": 0,    "max": 1000, "step": 1,    "label": "Purge bars between train/test",  "group": "Validation",   "description": "Bars dropped at the train/test boundary to defeat label leakage." },
        "final_epochs":    { "type": "int",   "default": 0,   "min": 0,    "max": 500,  "step": 1,    "label": "Final-fit epochs (0 = skip)",    "group": "HPO" },
        "horizon":         { "type": "int",   "default": 15,  "min": 1,    "max": 240,  "step": 1,    "label": "Range horizon (bars)",           "group": "Labels" },
        "bucket_size_pts": { "type": "float", "default": 2.0, "min": 0.25, "max": 20.0, "step": 0.25, "label": "Bucket width (points)",          "group": "Labels" },
        "window_size":     { "type": "int",   "default": 128, "min": 16,   "max": 512,  "step": 8,    "label": "Window size (bars)",             "group": "Architecture" }
      },
      "cliFlags": {
        "n_trials":        "--n-trials",
        "epochs":          "--epochs",
        "n_folds":         "--n-folds",
        "fold_months":     "--fold-months",
        "purge_bars":      "--purge-bars",
        "final_epochs":    "--final-epochs",
        "horizon":         "--horizon",
        "bucket_size_pts": "--bucket-size-pts",
        "window_size":     "--window-size"
      }
    },

    "transformer_direction_daily": {
      "name": "Daily-Direction Transformer (HPO)",
      "category": "neural-network",
      "subcategory": "Time-Series Transformers",
      "runner": "python",
      "script": "scripts/wrap-transformer-direction-daily.py",
      "featurePipeline": "self-contained",
      "outputs": ["hpo_results", "best_checkpoint", "diagnostics"],
      "chartOverlay": "prediction_markers",
      "outputDir": "data/models",
      "tags": ["transformer", "hpo", "binary-direction", "daily"],
      "family": "transformer",
      "gpuRequired": true,
      "estimatedTrainingTime": "5-30 min per study",
      "supportedObjectives": ["maximize_cost_adj_sharpe"],
      "description": "Tiny single-stream Transformer for MNQ daily binary direction. ~10-20k params, 4 walk-forward folds × 12mo each × 2-bar purge. Conviction = |sigmoid(logit_up - logit_down) - 0.5| * 2. Wrapper at scripts/wrap-transformer-direction-daily.py.",
      "defaultHyperparameters": {
        "n_trials":     { "type": "int", "default": 20,  "min": 1, "max": 200,   "step": 1, "label": "Optuna trials",                   "group": "HPO" },
        "epochs":       { "type": "int", "default": 20,  "min": 1, "max": 200,   "step": 1, "label": "Epochs per trial",                "group": "Training" },
        "batch_size":   { "type": "int", "default": 128, "min": 8, "max": 1024,  "step": 8, "label": "Batch size",                      "group": "Training" },
        "n_folds":      { "type": "int", "default": 4,   "min": 1, "max": 12,    "step": 1, "label": "Walk-forward folds",              "group": "Validation" },
        "fold_months":  { "type": "int", "default": 12,  "min": 1, "max": 36,    "step": 1, "label": "Fold size (months)",              "group": "Validation" },
        "purge_bars":   { "type": "int", "default": 2,   "min": 0, "max": 30,    "step": 1, "label": "Purge bars between train/test",   "group": "Validation" },
        "final_epochs": { "type": "int", "default": 30,  "min": 0, "max": 500,   "step": 1, "label": "Final-fit epochs (0 = skip)",     "group": "HPO" },
        "horizon":      { "type": "int", "default": 1,   "min": 1, "max": 30,    "step": 1, "label": "Direction horizon (bars)",        "group": "Labels" },
        "seed":         { "type": "int", "default": 42,  "min": 0, "max": 99999, "step": 1, "label": "Random seed",                     "group": "Reproducibility" }
      },
      "cliFlags": {
        "n_trials":     "--n-trials",
        "epochs":       "--epochs",
        "batch_size":   "--batch-size",
        "n_folds":      "--n-folds",
        "fold_months":  "--fold-months",
        "purge_bars":   "--purge-bars",
        "final_epochs": "--final-epochs",
        "horizon":      "--horizon",
        "seed":         "--seed"
      }
    }
  }
}
