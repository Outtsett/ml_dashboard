                "op": "sub",
                "a": {
                  "const": 100
                },
                "b": {
                  "param": "rsi_threshold"
                }
              }
            },
            {
              "op": "below",
              "a": "close",
              "b": {
                "vwap": "session_vwap"
              }
            },
            {
              "op": "session_window",
              "start": "07:00",
              "end": "11:00"
            }
          ]
        }
      },
      "exit": {
        "stop": {
          "kind": "atr",
          "mult": {
            "param": "stop_atr"
          }
        },
        "target": {
          "kind": "none"
        },
        "risk": {
          "max_entries_per_session": 2
        },
        "trail": {
          "breakeven_after_r": 1.0,
          "breakeven_offset_ticks": 1
        }
      },
      "constraints": {
        "maximum_session_end_exit_share": 1.0
      }
    },
    "momentum_expansion_control": {
      "description": "Level-free control for the breakout templates: a 15m bar that moves at least a tuned multiple of ATR in the trade direction, with RSI beyond a threshold and the MACD histogram on the same side of zero, in 06:30-10:30. Exits: ATR stop, 2R target, breakeven after 1R, the session end. If this earns as much as the level templates, the levels add nothing.",
      "params": {
        "move_atr": {
          "type": "float",
          "low": 0.75,
          "high": 2.0,
          "step": 0.25
        },
        "rsi_threshold": {
          "type": "int",
          "low": 56,
          "high": 76,
          "step": 2
        },
        "stop_atr": {
          "type": "float",
          "low": 1.0,
          "high": 3.0,
          "step": 0.5
        },
        "breakeven_r": {
          "type": "float",
          "low": 0.75,
          "high": 1.5,
          "step": 0.25
        }
      },
      "defaults": {
        "move_atr": 1.0,
        "rsi_threshold": 60,
        "stop_atr": 1.5,
        "breakeven_r": 1.0
      },
      "series": {
        "rsi": {
          "ind": "RSI",
          "args": {
            "timeperiod": 14
          }
        },
        "macd_histogram": {
          "ind": "MACD",
          "args": {
            "fastperiod": 12,
            "slowperiod": 26,
            "signalperiod": 9
          },
          "out": 2
        },
        "bar_move": {
          "op": "sub",
          "a": "close",
          "b": {
            "op": "lag",
            "of": "close",
            "n": 1
          }
        }
      },
      "gate": {
        "op": "session_window",
        "start": "06:30",
        "end": "10:30"
      },
      "entry": {
        "long": {
          "op": "all",
          "of": [
            {
              "op": "at_least",
              "a": "$bar_move",
              "b": {
                "op": "mul",
                "a": "atr",
                "b": {
                  "param": "move_atr"
                }
              }
            },
            {
              "op": "above",
              "a": "$rsi",
              "b": {
                "param": "rsi_threshold"
              }
            },
            {
              "op": "above",
              "a": "$macd_histogram",
              "b": {
                "const": 0
              }
            },
            {
              "op": "session_window",
              "start": "06:30",
              "end": "10:30"
            }
          ]
        },
        "short": {
          "op": "all",
          "of": [
            {
              "op": "at_least",
              "a": {
                "op": "mul",
                "a": "$bar_move",
                "b": {
                  "const": -1
                }
              },
              "b": {
                "op": "mul",
                "a": "atr",
                "b": {
                  "param": "move_atr"
                }
              }
            },
            {
              "op": "below",
              "a": "$rsi",
              "b": {
                "op": "sub",
                "a": {
                  "const": 100
                },
                "b": {
                  "param": "rsi_threshold"
                }
              }
            },
            {
              "op": "below",
              "a": "$macd_histogram",
              "b": {
                "const": 0
              }
            },
            {
              "op": "session_window",
              "start": "06:30",
              "end": "10:30"
            }
          ]
        }
      },
      "exit": {
        "stop": {
          "kind": "atr",
          "mult": {
            "param": "stop_atr"
          }
        },
        "target": {
          "kind": "r",
          "value": 2.0
        },
        "trail": {
          "breakeven_after_r": {
            "param": "breakeven_r"
          },
          "breakeven_offset_ticks": 1
        },
        "risk": {
          "max_entries_per_session": 2
        }
      }
    }
  }
}