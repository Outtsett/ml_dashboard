{
  "version": 2,
  "categories": {
    "returns": {
      "name": "Returns",
      "description": "Log returns at various horizons"
    },
    "volatility": {
      "name": "Realized Volatility",
      "description": "Rolling std of returns"
    },
    "parkinson": {
      "name": "Range-Based Volatility",
      "description": "Parkinson high-low volatility estimator"
    },
    "volume": {
      "name": "Volume Dynamics",
      "description": "Relative volume ratios"
    },
    "price_structure": {
      "name": "Price Structure",
      "description": "Candle anatomy and structural pivot features"
    },
    "momentum": {
      "name": "Rate of Change",
      "description": "Price momentum at multiple horizons"
    },
    "ma_distance": {
      "name": "Moving Average Distance",
      "description": "Distance from moving averages"
    },
    "microstructure": {
      "name": "Microstructure",
      "description": "Order book metrics and high-frequency price action patterns"
    },
    "mean_reversion": {
      "name": "Mean Reversion Logic",
      "description": "Distance from value and elasticity metrics"
    },
    "anatomy": {
      "name": "Candle Anatomy",
