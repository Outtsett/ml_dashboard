# ML Dashboard - Environment Configuration
# Copy this file to .env and adjust values for your setup.

# ── Server ──
PORT=5000
NODE_ENV=development

# ── QuestDB (time-series database, must be running separately) ──
QUESTDB_HOST=localhost
QUESTDB_HTTP_PORT=9000
QUESTDB_PG_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest

# ── QuestDB local installation (auto-start support) ──
# Path to the QuestDB root directory (contains bin/java.exe on Windows)
# QUESTDB_ROOT=
# Path to the java.exe used by QuestDB (defaults to $QUESTDB_ROOT/bin/java.exe)
# QUESTDB_JAVA=

# ── Database paths ──
SQLITE_PATH=./data/ml_dashboard.db

# ── Local storage (defaults to ./data/object-storage if not set) ──
# LOCAL_STORAGE_ROOT=./data/object-storage

# ── External APIs (optional) ──
# ALPHA_VANTAGE_API_KEY=your_key_here
