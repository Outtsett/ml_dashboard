# ML Dashboard - Environment Configuration
# Copy this file to .env and adjust values for your setup.

# ── Server ──
# PORT is honoured everywhere: the socket binds it, and the CORS allow-list is
# derived from it. Do not reintroduce a hardcoded origin — a literal 5000 in the
# allow-list made the server reject its own bundle with a 500 on every other port.
PORT=5000
NODE_ENV=development

# ── Hardware telemetry (optional) ──
# Interpreter that runs scripts/hardware_node.py. Defaults to `python` on Windows
# and `python3` elsewhere. If it cannot be spawned the node logs once and stays
# disabled; the dashboard runs without CPU/GPU telemetry.
# HARDWARE_NODE_PYTHON=C:\Users\you\anaconda3\python.exe

# ── Rate limiting ──
# Scales every API rate-limit ceiling. Default 1 — leave it unset outside tests.
# The Playwright harness sets it (playwright.config.ts) because several browser
# contexts share one 127.0.0.1 bucket and trip the 50-per-10s query limit.
# NEVER set this in a production deployment.
# RATE_LIMIT_MULTIPLIER=1

# ── End-to-end tests ──
# Port the Playwright harness runs its own server on. Never 5000 — that is the
# dashboard you keep running, and EADDRINUSE is a hard exit in the server.
# E2E_PORT=5099

# ── Market data ──
# Read with DuckDB over the Iceberg lake at E:\lake, in-process. There is no
# database server to start and no host/port/credential to set here.

# ── Database paths ──
SQLITE_PATH=./data/ml_dashboard.db

# ── Local storage (defaults to ./data/object-storage if not set) ──
# LOCAL_STORAGE_ROOT=./data/object-storage

# ── External APIs (optional) ──
# ALPHA_VANTAGE_API_KEY=your_key_here
