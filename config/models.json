{
  "version": 1,
  "models": {
    "hdp-hmm": {
      "name": "HDP-HMM Regime Detector",
      "category": "unsupervised",
      "subcategory": "clustering",
      "runner": "python",
      "script": "scripts/train-hdp-hmm.py",
      "featurePipeline": "hdp-hmm-12",
      "outputs": ["regimes", "diagnostics", "convergence"],
      "chartOverlay": "regime_colors",
      "outputDir": "data/models/hdp-hmm",
      "requiresDataExport": true,
      "defaultHyperparameters": {
        "gibbsIter": { "value": 100, "min": 20, "max": 500, "step": 10, "label": "Gibbs Iterations" },
        "burnIn": { "value": 30, "min": 5, "max": 200, "step": 5, "label": "Burn-in" },
        "testSplit": { "value": 0.15, "min": 0.05, "max": 0.40, "step": 0.05, "label": "Test Split" },
        "wfWindows": { "value": 5, "min": 2, "max": 10, "step": 1, "label": "Walk-Forward Windows" },
        "alpha": { "value": 1.0, "min": 0.01, "max": 10.0, "step": 0.1, "label": "Alpha (transition concentration)" },
        "gamma": { "value": 5.0, "min": 0.1, "max": 50.0, "step": 0.5, "label": "Gamma (DP concentration)" },
        "kappa": { "value": 50.0, "min": 1.0, "max": 200.0, "step": 5.0, "label": "Kappa (stickiness)" }
      }
    },
    "cnn-universal": {
      "name": "CNN-1D Classifier",
      "category": "supervised",
      "subcategory": "classification",
      "runner": "tfjs",
      "featurePipeline": "universal-30",
      "outputs": ["predictions", "model_weights"],
      "chartOverlay": "prediction_markers",
      "outputDir": "data/models",
      "requiresDataExport": false,
      "defaultHyperparameters": {
        "epochs": { "value": 50, "min": 5, "max": 200, "step": 5, "label": "Epochs" },
        "batchSize": { "value": 32, "min": 8, "max": 256, "step": 8, "label": "Batch Size" },
        "learningRate": { "value": 0.0005, "min": 0.00001, "max": 0.01, "step": 0.0001, "label": "Learning Rate" },
        "sequenceLength": { "value": 60, "min": 10, "max": 200, "step": 10, "label": "Lookback Bars" },
        "dropoutRate": { "value": 0.3, "min": 0.0, "max": 0.8, "step": 0.05, "label": "Dropout" }
      }
    }
  }
}
