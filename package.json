  "build": {
    "appId": "com.ml-dashboard.app",
    "productName": "Quant AI Dashboard",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icons/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quant AI Dashboard"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.png"
    }
  }
