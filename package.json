{
  "name": "quant-ai-dashboard",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --env-file=.env --import tsx src/server/main.ts",
    "dev:client": "vite dev --port 5000",
    "build": "tsx build.ts",
    "build:electron": "tsx build.ts && electron-builder",
    "start": "cross-env NODE_ENV=production node --env-file=.env dist/index.cjs",
    "start:desktop": "cross-env NODE_ENV=production electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5000/health && cross-env NODE_ENV=development electron .\"",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "db:push": "npx drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:py && npm run lint:ts",
    "lint:py": "ruff check --fix src/ml/ scripts/",
    "lint:ts": "eslint --fix src/",
    "check:architecture": "tsx src/scripts/architecture_validator.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "src/ml/**/*.py": [
      "ruff check --fix"
    ],
    "scripts/**/*.py": [
      "ruff check --fix"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "@questdb/nodejs-client": "^4.2.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@swc/core": "^1.15.13",
    "@swc/helpers": "^0.5.19",
    "@tanstack/react-query": "^5.60.5",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "electron-store": "^8.2.0",
    "eventemitter2": "^6.4.9",
    "express": "^5.0.1",
    "form-data": "^4.0.5",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.1.0",
    "fzstd": "^0.1.1",
    "input-otp": "^1.4.2",
    "lightweight-charts": "^5.1.0",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.545.0",
    "multer": "^2.0.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-resizable-panels": "^2.1.9",
    "react-window": "^2.2.5",
    "recharts": "^2.15.4",
    "reflect-metadata": "^0.2.2",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^0.3.28",
    "unplugin-swc": "^1.5.9",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "xstate": "^5.28.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.8.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.12",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.0",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.1.9",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "build": {
    "appId": "com.ml-dashboard.app",
    "productName": "Quant AI Dashboard",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icons/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quant AI Dashboard"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.png"
    }
  }
}
