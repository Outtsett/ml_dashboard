{
  "name": "quant-ai-dashboard",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch --env-file=.env src/server/main.ts",
    "dev:no-watch": "cross-env NODE_ENV=development node --env-file=.env --import tsx src/server/main.ts",
    "//dev:lean": "Same server as `dev` in 2 node processes instead of 5. `dev` goes npm -> cross-env -> tsx -> node --watch -> app; only the last does work. cross-env is redundant because .env already sets NODE_ENV, and tsx's --watch is forwarded into the child as a NODE flag, so Node's own watcher nests inside tsx's chokidar watcher and both race on save.",
    "dev:lean": "node --watch --env-file=.env --import tsx src/server/main.ts",
    "dev:solo": "node --env-file=.env --import tsx src/server/main.ts",
    "//dev:stop": "Kills the TOP of the dashboard process tree. Killing the port-5000 holder instead leaves the watch supervisor orphaned, which is how three dead chains accumulated.",
    "dev:stop": "node scripts/stop_dashboard.mjs",
    "dev:client": "vite dev --port 5000",
    "build": "tsx build.ts",
    "build:electron": "tsx build.ts && electron-builder",
    "start": "cross-env NODE_ENV=production node --env-file=.env dist/index.cjs",
    "start:desktop": "cross-env NODE_ENV=production electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5000/health && cross-env NODE_ENV=development electron .\"",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "db:push": "npx drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "//e2e": "End-to-end. `test:e2e` builds first because the server serves dist/public in production mode and refuses to start without it.",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:hermetic": "playwright test --grep-invert \"@lake|@stream\"",
    "test:e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps chromium",
    "smoke": "node scripts/smoke.mjs",
    "test:ci": "vitest run --exclude \"tests/client/**\" --reporter=dot",
    "test:coverage": "vitest run --coverage --exclude \"tests/client/**\" --exclude \"**/performance.test.ts\" --reporter=dot",
    "ci": "node scripts/ci-local.mjs",
    "lint:py:check": "python -m ruff check src/ml/ scripts/",
    "lint": "npm run lint:py && npm run lint:ts",
    "lint:py": "python -m ruff check --fix src/ml/ scripts/",
    "lint:ts": "eslint --fix --cache --cache-location node_modules/.cache/eslint/ src/",
    "check:architecture": "tsx src/scripts/architecture_validator.ts",
    "analyze": "cross-env ANALYZE=true vite build",
    "verify": "node scripts/verify.mjs --changed",
    "lint:ci": "node scripts/lint-budget.mjs",
    "lint:baseline": "node scripts/lint-budget.mjs --update",
    "deps:report": "node scripts/dependency-report.mjs",
    "prepare": "husky",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:local:fast": "node scripts/ci-local.mjs --fast",
    "//ci": "Single source of truth for \"is this green?\". scripts/ci-local.mjs mirrors .github/workflows/ci.yml stage for stage; the old hand-chained list drifted from CI (it ran check:architecture, which CI did not; CI ran ruff format --check and widened ruff check, which it did not).",
    "test:e2e:a11y": "playwright test e2e/specs/a11y",
    "test:e2e:a11y:record": "cross-env A11Y_UPDATE_BASELINE=1 playwright test e2e/specs/a11y"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "src/ml/**/*.py": [
      "python -m ruff check --fix"
    ],
    "scripts/**/*.py": [
      "python -m ruff check --fix"
    ]
  },
