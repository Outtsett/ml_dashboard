# =============================================================================
# ML Dashboard — .gitignore
# =============================================================================
# This repository is published under a Source-Available View-Only License (see
# LICENSE). Anything that contains secrets, credentials, personal information,
# local environment paths, internal planning notes, AI-assistant scratch data,
# build artifacts, runtime state, or large generated data MUST be excluded.
# =============================================================================

# ── Secrets & credentials ────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.secrets
*.secrets
secrets/
secrets.json
credentials.json
credentials/
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.kdbx
*.gpg
.netrc
.npmrc.local
.pypirc

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
release/
out/
*.egg-info/
*.whl
.next/
.cache/
.parcel-cache/

# ── Database files & data ────────────────────────────────────────────────────
# ANCHORED to the repo root. A bare `data/` matches a directory named `data` at
# ANY depth, which silently excluded real source: src/client/src/data (the whole
# Databases page), src/server/data (5 routers) and
# src/client/src/system/architecture-explorer/mechanism/data. Those 16 files were
# untracked and existed only on one machine. Keep the leading slash.
/data/
# ML training outputs also live under src/ml/data — those ARE artifacts.
# (*.pt below already covers checkpoints; this covers the rest.)
src/ml/data/
*.db
*.db-journal
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.questdb
.questdb.pid
.questdb/
parquet/
*.parquet
!tests/fixtures/lens/**
*.feather
*.arrow

# ── Model artifacts & training outputs ───────────────────────────────────────
checkpoints/
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.onnx
*.safetensors
*.npz
*.npy
*.pkl
*.pickle
*.joblib
mlruns/
optuna_studies/
runs/
tensorboard/
lightning_logs/

