# ── Local-only Python notebook outputs (keep stripped notebooks only) ────────
# Use `nbstripout --install` to strip outputs automatically before committing.

# ── Strategy research outputs (proprietary tuned parameters) ─────────────────
scripts/orb_*.txt
scripts/orb_*.json
scripts/orb_error.txt
scripts/_*.py

# ── Local tool scratch (never reaches git) ───────────────────────────────────
# Browser-automation console dumps and generated analytics figures are run
# artifacts, not source. Analytics belongs in the dashboard, not in image files.
.playwright-mcp/
outputs/

# ── End-to-end run artifacts ─────────────────────────────────────────────────
# Playwright writes traces, videos, screenshots and the HTML report per run.
# A single failing route sweep produces tens of megabytes; none of it is source.
# `e2e/` itself IS tracked — the specs, fixtures and route table are code.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Throwaway database the local CI schema stage builds to verify the
# create-from-scratch path without touching the working data/ml_dashboard.db.
data/.ci-local-schema-check.db*

# ── Tool caches (never commit) ───────────────────────────────────────────────
node_modules/.cache/
.claude/state/

# Weights & Biases run artifacts — regenerated by every training run, never source.
wandb/

# marimo session cache (regenerated on every notebook run)
__marimo__/

# ── Other repositories and scratch kept beside this one (never commit) ───────
# Trading/ holds the quant, forexmodel and quantlab repositories (each with its
# own remote) and the algo_models corpus the catalog reads at runtime: 18 GB.
/Trading/
# Scratch: spent codemods, verification output, optimizer logs, reference snippets.
/fix_app.py
/fix_switch.py
/update_app.py
/update_paths.py
/'2025-01-01'
/.tmp_verify/
/scripts/.tmp/
/outcmaes/
/snips/

