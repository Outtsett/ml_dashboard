{% block eval_block %}
    # ─── W3.b pytorch MLP {{ _task_kind }} rollup ────────────────────────
    if _FOLD_STATE["y"]:
        all_y_raw = np.concatenate([np.asarray(y).reshape(-1) for y in _FOLD_STATE["y"]])
        preds_list = _FOLD_STATE["preds"]
        if preds_list and preds_list[0].ndim == 2:
            all_preds = np.concatenate(preds_list, axis=0).astype(np.float64)
        else:
            all_preds = np.concatenate([np.asarray(p).reshape(-1) for p in preds_list]).astype(np.float64)
    else:
        all_y_raw = np.asarray([], dtype=np.float64)
        all_preds = np.asarray([], dtype=np.float64)

    {% if _task_kind == "regression" %}
    all_y = all_y_raw.astype(np.float64)
    fallback_y = np.asarray([0.0, 1.0])
    fallback_p = np.asarray([0.5, 0.5])
    {% else %}
    all_y = all_y_raw.astype(np.int64)
    fallback_y = np.asarray([0, 1], dtype=np.int64)
    fallback_p = np.asarray([0.5, 0.5])
    {% endif %}

    _emit_metric_declarations()

    diagnostics = build_diagnostics(
        model=None,
        y_true=all_y if all_y.size else fallback_y,
        y_pred=all_preds if all_preds.size else fallback_p,
