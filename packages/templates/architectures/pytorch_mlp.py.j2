{# ---------------------------------------------------------------------- #}
{# pytorch_mlp.py.j2 — configurable depth/width MLP (W3.b)                #}
{#                                                                         #}
{# Renders a self-contained generated trainer for a pure-MLP architecture #}
{# over the (B, F) flat feature matrix produced by                         #}
{# src.ml.shared.features.compute_features.                                #}
{#                                                                         #}
{# Hyperparameters consumed (via ctx.hyperparameters):                     #}
{#   hidden_dims          (list[int])  — layer widths, e.g. [128, 64]      #}
{#   dropout              (float)      — applied after each hidden layer   #}
{#   learning_rate        (float)      — AdamW lr                          #}
{#   n_epochs             (int)        — max training epochs               #}
{#   batch_size           (int)        — minibatch size                    #}
{#   early_stop_patience  (int)        — epochs w/o val improvement → stop #}
{#   task_kind            (str)        — "classification" | "regression"   #}
{#   n_classes            (int)        — only used for classification      #}
{#                                                                         #}
{# Imports MLPEncoder + ClassificationHead/BinaryDirectionHead/            #}
{# RegressionHead from src.ml.blocks.                                      #}
{# Loss: BCE for binary, CE for multi-class, MSE for regression.           #}
{# Early-stop on val loss with `early_stop_patience` epochs of no         #}
{# improvement.                                                            #}
{# ---------------------------------------------------------------------- #}
{% extends "_base.py.j2" %}

{% set _task_kind = task_kind | default("classification") %}
{% set _n_classes = n_classes | default(2) %}
{% set _hidden_dims = hyperparameters.hidden_dims | default([128, 64]) %}
{% set _dropout = hyperparameters.dropout | default(0.1) %}
{% set _lr = hyperparameters.learning_rate | default(0.001) %}
{% set _n_epochs = hyperparameters.n_epochs | default(20) %}
{% set _batch_size = hyperparameters.batch_size | default(256) %}
{% set _patience = hyperparameters.early_stop_patience | default(5) %}

{# NOTE: `time` is already imported by _base.py.j2 — re-importing here is a #}
{# redefinition (F811) in the rendered module.                              #}
{% block model_imports %}
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, TensorDataset

from src.ml.blocks import MLPEncoder
from src.ml.shared.torch_logging import (
    declare_diagnostics_metrics, emit_step_diagnostics,
    global_grad_norm, current_lr, vram_mb,
)
{% if _task_kind == "regression" %}
from src.ml.blocks import RegressionHead
{% elif _n_classes == 2 %}
from src.ml.blocks import BinaryDirectionHead
{% else %}
from src.ml.blocks import ClassificationHead
{% endif %}

# Static config baked into the rendered template.
_TASK_KIND: str = {{ _task_kind | python_repr }}
_N_CLASSES: int = {{ _n_classes | python_repr }}
_HIDDEN_DIMS: list = {{ _hidden_dims | python_repr }}
_DROPOUT: float = {{ _dropout | python_repr }}
_LR: float = {{ _lr | python_repr }}
_N_EPOCHS: int = {{ _n_epochs | python_repr }}
_BATCH_SIZE: int = {{ _batch_size | python_repr }}
_PATIENCE: int = {{ _patience | python_repr }}
_DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Module-level state for per-fold OOS aggregation (read by rollup block).
_FOLD_STATE: dict = {"y": [], "preds": [], "ts": []}
_DIAG_DECLARED: dict = {"done": False}


class _MLPModel(nn.Module):
    """MLPEncoder body + task-specific head.

    encoder : MLPEncoder(input_dim, hidden_dims, dropout)
    head    : ClassificationHead | BinaryDirectionHead | RegressionHead

    Forward returns the head's raw output (logits for classification,
    real-valued scalar for regression).
    """

    def __init__(self, input_dim: int):
        super().__init__()
        self.encoder = MLPEncoder(
            input_dim=input_dim,
            hidden_dims=_HIDDEN_DIMS,
            dropout=_DROPOUT,
        )
        latent_dim = int(_HIDDEN_DIMS[-1])
        {% if _task_kind == "regression" %}
        self.head = RegressionHead(d_model=latent_dim, n_targets=1)
        {% elif _n_classes == 2 %}
        self.head = BinaryDirectionHead(d_model=latent_dim)
        {% else %}
        self.head = ClassificationHead(d_model=latent_dim, n_classes=_N_CLASSES)
        {% endif %}

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        z = self.encoder(x)
        return self.head(z)
{% endblock %}

{% block train_loop %}
def _make_loaders(X_train, y_train, X_test, y_test):
    """Build train/val DataLoaders. Numpy → float32 tensors for X; long for
    classification y, float for regression y."""
    X_tr = torch.as_tensor(np.asarray(X_train), dtype=torch.float32)
    X_te = torch.as_tensor(np.asarray(X_test), dtype=torch.float32)
    {% if _task_kind == "regression" %}
    y_tr = torch.as_tensor(np.asarray(y_train), dtype=torch.float32).reshape(-1, 1)
    y_te = torch.as_tensor(np.asarray(y_test), dtype=torch.float32).reshape(-1, 1)
    {% else %}
    y_tr = torch.as_tensor(np.asarray(y_train), dtype=torch.long).reshape(-1)
    y_te = torch.as_tensor(np.asarray(y_test), dtype=torch.long).reshape(-1)
    {% endif %}
    train_ds = TensorDataset(X_tr, y_tr)
    val_ds = TensorDataset(X_te, y_te)
    train_loader = DataLoader(
        train_ds, batch_size=_BATCH_SIZE, shuffle=True,
        num_workers=0, pin_memory=(_DEVICE.type == "cuda"),
    )
    val_loader = DataLoader(
        val_ds, batch_size=_BATCH_SIZE, shuffle=False,
        num_workers=0, pin_memory=(_DEVICE.type == "cuda"),
    )
    return train_loader, val_loader


def _loss_fn(logits: torch.Tensor, y: torch.Tensor) -> torch.Tensor:
    """Task-aware loss. BCE-with-logits for binary, CE for multi-class, MSE for
    regression. logits shape is (B,) for binary and regression, (B, K) for
    multi-class."""
    {% if _task_kind == "regression" %}
    return F.mse_loss(logits.reshape(-1), y.reshape(-1))
    {% elif _n_classes == 2 %}
    return F.binary_cross_entropy_with_logits(logits.reshape(-1), y.reshape(-1).float())
    {% else %}
    return F.cross_entropy(logits, y.reshape(-1))
    {% endif %}


def _logits_to_preds(logits: torch.Tensor) -> np.ndarray:
    """Convert raw head output to the array shape downstream rollup expects.

    Binary classification → P(class==1) per row, shape (n,).
    Multi-class → softmax probabilities, shape (n, K).
    Regression → raw real-valued forecast, shape (n,).
    """
    {% if _task_kind == "regression" %}
    return logits.detach().cpu().numpy().reshape(-1).astype(np.float64)
    {% elif _n_classes == 2 %}
    return torch.sigmoid(logits.reshape(-1)).detach().cpu().numpy().astype(np.float64)
    {% else %}
    return F.softmax(logits, dim=-1).detach().cpu().numpy().astype(np.float64)
    {% endif %}


def train_one_fold(X_train, y_train, X_test, y_test, args, *, fold_idx=None, ts_test=None):
    """MLP + AdamW + early-stop on val loss. Returns (model, preds)."""
    fold_tag = "single" if fold_idx is None else str(fold_idx)
    input_dim = int(X_train.shape[1])
    model = _MLPModel(input_dim=input_dim).to(_DEVICE)
    optimizer = torch.optim.AdamW(model.parameters(), lr=_LR, weight_decay=1e-4)
    train_loader, val_loader = _make_loaders(X_train, y_train, X_test, y_test)

    best_val_loss = float("inf")
    best_state: dict | None = None
    epochs_no_improve = 0

    if not _DIAG_DECLARED["done"]:
        declare_diagnostics_metrics()
        _DIAG_DECLARED["done"] = True
    if _DEVICE.type == "cuda":
        torch.cuda.reset_peak_memory_stats()

    for epoch in range(_N_EPOCHS):
        # ── train ─────────────────────────────────────────────────────
        model.train()
        t0 = time.perf_counter()
        train_loss_sum = 0.0
        n_train_samples = 0
        grad_norm_sum = 0.0
        n_batches = 0
        for xb, yb in train_loader:
            xb = xb.to(_DEVICE, non_blocking=True)
            yb = yb.to(_DEVICE, non_blocking=True)
            optimizer.zero_grad(set_to_none=True)
            logits = model(xb)
            loss = _loss_fn(logits, yb)
            loss.backward()
            grad_norm_sum += global_grad_norm(model)
            n_batches += 1
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()
            train_loss_sum += float(loss.item()) * xb.size(0)
            n_train_samples += xb.size(0)
        epoch_dt = max(1e-6, time.perf_counter() - t0)
        train_loss = train_loss_sum / max(1, n_train_samples)

        # ── val ───────────────────────────────────────────────────────
        model.eval()
        val_loss_sum = 0.0
        n_val_samples = 0
        with torch.no_grad():
            for xb, yb in val_loader:
                xb = xb.to(_DEVICE, non_blocking=True)
                yb = yb.to(_DEVICE, non_blocking=True)
                logits = model(xb)
                vloss = _loss_fn(logits, yb)
                val_loss_sum += float(vloss.item()) * xb.size(0)
                n_val_samples += xb.size(0)
        val_loss = val_loss_sum / max(1, n_val_samples)

        emit_metric(name=f"fold_{fold_tag}_train_loss", value=float(train_loss), iteration=epoch)
        emit_metric(name=f"fold_{fold_tag}_val_loss", value=float(val_loss), iteration=epoch)
        emit_step_diagnostics(
            step=epoch, total=_N_EPOCHS,
            grad_norm=grad_norm_sum / max(1, n_batches),
            lr=current_lr(optimizer),
            throughput=n_train_samples / epoch_dt,
            vram=vram_mb(),
        )
        emit_log(
            f"[mlp][fold={fold_tag}] epoch {epoch+1}/{_N_EPOCHS} "
            f"train_loss={train_loss:.6f} val_loss={val_loss:.6f}"
        )

        if val_loss + 1e-9 < best_val_loss:
            best_val_loss = val_loss
            best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}
            epochs_no_improve = 0
        else:
            epochs_no_improve += 1
            if epochs_no_improve >= _PATIENCE:
                emit_log(
                    f"[mlp][fold={fold_tag}] early stop at epoch {epoch+1} "
                    f"(no improvement for {_PATIENCE} epochs)"
                )
                break

    if best_state is not None:
        model.load_state_dict(best_state)

    # Final OOS prediction pass.
    model.eval()
    preds_chunks: list[np.ndarray] = []
    with torch.no_grad():
        for xb, _yb in val_loader:
            xb = xb.to(_DEVICE, non_blocking=True)
            logits = model(xb)
            preds_chunks.append(_logits_to_preds(logits))
    if preds_chunks:
        preds = np.concatenate(preds_chunks, axis=0)
    else:
        preds = np.asarray([], dtype=np.float64)

    _FOLD_STATE["y"].append(np.asarray(y_test))
    _FOLD_STATE["preds"].append(preds)
    if ts_test is not None:
        _FOLD_STATE["ts"].append(np.asarray(ts_test))

    return model, preds


def predict(model, X) -> np.ndarray:
    """Standard predict contract: returns 1D probability/score for binary +
    regression, or (n, K) softmax matrix for multi-class."""
    model.eval()
    X_t = torch.as_tensor(np.asarray(X), dtype=torch.float32)
    out_chunks: list[np.ndarray] = []
    with torch.no_grad():
        for i in range(0, X_t.shape[0], _BATCH_SIZE):
            chunk = X_t[i:i + _BATCH_SIZE].to(_DEVICE, non_blocking=True)
            logits = model(chunk)
            out_chunks.append(_logits_to_preds(logits))
    if out_chunks:
        return np.concatenate(out_chunks, axis=0)
    return np.asarray([], dtype=np.float64)
{% endblock %}

