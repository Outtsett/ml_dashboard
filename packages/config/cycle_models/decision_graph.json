          "choices": [
            "hill_climb",
            "tree_augmented",
            "naive"
          ],
          "label": "Structure search",
          "group": "Model",
          "description": "pgmpy hill climbing on the BIC score, the tree-augmented naive Bayes tree, or naive Bayes.",
