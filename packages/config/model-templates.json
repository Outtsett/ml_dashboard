{
  "version": 1,
  "description": "Model family templates for auto-configuring catalog models. When a catalog model has no entry in models.json, the system matches its family tag to a template here and generates a training-ready configuration.",
  "templates": {
    "hmm": {
      "name": "Hidden Markov Models",
      "runner": "python",
      "scriptTemplate": "packages/ml-engine/src/generic/hmm/train.py",
      "featurePipeline": "configurable",
      "outputs": [
        "regimes",
        "transition_matrix",
        "convergence"
      ],
      "chartOverlay": "regime_bands",
      "outputDir": "data/models",
      "gpuRequired": false,
      "defaultFeatureCategories": [
        "returns",
        "volatility"
      ],
      "supportedObjectives": [
        "minimize_loss",
        "maximize_log_likelihood"
      ],
      "estimatedTrainingTime": "1-5 min",
      "tags": [
        "unsupervised",
        "time-series",
        "regime-detection"
      ],
      "standardHyperparameters": {
        "n_states": {
          "value": 3,
          "min": 2,
          "max": 10,
          "step": 1,
          "label": "Number of States",
          "type": "int",
          "description": "Number of hidden states (regimes) the model can identify",
          "group": "Architecture",
          "searchSpace": {
            "min": 2,
            "max": 8,
            "step": 1
          }
        },
        "n_iter": {
          "value": 100,
          "min": 10,
          "max": 1000,
          "step": 10,
          "label": "Max Iterations",
          "type": "int",
          "description": "Maximum number of EM iterations for convergence",
          "group": "Training",
          "searchSpace": {
            "min": 50,
            "max": 500,
            "step": 50
          }
        },
        "covariance_type": {
          "value": "full",
          "label": "Covariance Type",
          "type": "categorical",
          "description": "Type of covariance matrix used for emission distributions",
          "group": "Architecture",
          "choices": [
            "spherical",
            "diag",
            "full",
            "tied"
          ]
        },
        "algorithm": {
          "value": "viterbi",
          "label": "Decoding Algorithm",
          "type": "categorical",
          "description": "Algorithm for finding the most likely state sequence",
          "group": "Architecture",
          "choices": [
            "viterbi",
            "map"
          ]
        },
        "tol": {
          "value": 0.01,
          "min": 1e-06,
          "max": 0.1,
          "step": 0.001,
          "label": "Convergence Tolerance",
          "type": "float",
          "description": "Convergence threshold for EM algorithm log-likelihood change",
          "group": "Training",
          "searchSpace": {
            "min": 1e-06,
            "max": 0.01,
            "scale": "log"
          }
        },
        "n_random_starts": {
          "value": 5,
          "min": 1,
          "max": 50,
          "step": 1,
          "label": "Random Restarts",
          "type": "int",
          "description": "Number of random initializations to avoid local optima",
          "group": "Training"
        }
      }
    },
    "sklearn": {
      "name": "Scikit-learn Models",
      "runner": "python",
      "scriptTemplate": "packages/ml-engine/src/generic/sklearn/train.py",
      "featurePipeline": "configurable",
      "outputs": [
        "predictions",
        "feature_importance",
        "metrics"
      ],
      "chartOverlay": "prediction_line",
      "outputDir": "data/models",
      "gpuRequired": false,
      "defaultFeatureCategories": [
        "returns",
        "volatility",
        "momentum",
        "volume"
      ],
      "supportedObjectives": [
        "minimize_loss",
        "maximize_accuracy",
        "maximize_f1",
        "maximize_auc"
      ],
      "estimatedTrainingTime": "1-10 min",
      "tags": [
        "supervised",
        "classification",
        "regression",
        "random-forest",
        "svm",
        "gradient-boosting"
      ],
      "subFamilies": {
        "random_forest": [
          "n_estimators",
          "max_depth",
          "min_samples_split",
          "min_samples_leaf",
          "max_features"
        ],
        "svm": [
          "C",
          "kernel",
          "gamma"
        ],
        "gradient_boosting": [
          "n_estimators",
          "max_depth",
          "learning_rate",
          "subsample"
        ]
      },
      "standardHyperparameters": {
        "n_estimators": {
          "value": 100,
          "min": 10,
          "max": 2000,
          "step": 10,
          "label": "Number of Estimators",
          "type": "int",
          "description": "Number of trees in the ensemble (RandomForest, GradientBoosting)",
          "group": "Architecture",
          "searchSpace": {
            "min": 50,
            "max": 1000,
            "step": 50
          }
        },
        "max_depth": {
          "value": 10,
          "min": 1,
          "max": 50,
          "step": 1,
          "label": "Max Tree Depth",
          "type": "int",
          "description": "Maximum depth of each tree; controls model complexity",
          "group": "Architecture",
          "searchSpace": {
            "min": 3,
            "max": 30,
            "step": 1
          }
        },
        "min_samples_split": {
          "value": 2,
          "min": 2,
          "max": 50,
          "step": 1,
          "label": "Min Samples to Split",
          "type": "int",
          "description": "Minimum samples required to split an internal node",
          "group": "Regularization"
        },
        "min_samples_leaf": {
          "value": 1,
          "min": 1,
          "max": 50,
          "step": 1,
          "label": "Min Samples per Leaf",
          "type": "int",
          "description": "Minimum samples required at a leaf node",
          "group": "Regularization"
        },
        "max_features": {
          "value": "sqrt",
          "label": "Max Features",
          "type": "categorical",
          "description": "Number of features to consider for best split",
          "group": "Regularization",
          "choices": [
            "sqrt",
            "log2",
            "auto",
            "none"
          ]
        },
        "learning_rate": {
          "value": 0.1,
          "min": 0.0001,
          "max": 0.01,
          "step": 0.0001,
          "label": "Learning Rate",
          "type": "float",
          "description": "Step size shrinkage to prevent overfitting (GradientBoosting)",
          "group": "Training",
          "searchSpace": {
            "min": 1e-05,
            "max": 0.1,
            "scale": "log"
          }
        },
        "subsample": {
          "value": 1.0,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "label": "Subsample Ratio",
          "type": "float",
          "description": "Fraction of samples used for fitting each tree (GradientBoosting)",
          "group": "Regularization"
        },
        "C": {
          "value": 1.0,
          "min": 0.001,
          "max": 100.0,
          "step": 0.1,
          "label": "Regularization (C)",
          "type": "float",
          "description": "Inverse regularization strength for SVM",
          "group": "Regularization",
          "searchSpace": {
            "min": 0.001,
            "max": 1000.0,
            "scale": "log"
          }
        },
        "kernel": {
          "value": "rbf",
          "label": "SVM Kernel",
          "type": "categorical",
          "description": "Kernel type for SVM decision boundary",
          "group": "Architecture",
          "choices": [
            "linear",
            "poly",
            "rbf",
            "sigmoid"
          ]
        },
        "gamma": {
          "value": "scale",
          "label": "Kernel Coefficient",
          "type": "categorical",
          "description": "Kernel coefficient for rbf/poly/sigmoid kernels",
          "group": "Architecture",
          "choices": [
            "scale",
            "auto"
          ]
        }
      }
    },
    "pytorch": {
      "name": "PyTorch Neural Networks",
      "runner": "python",
      "scriptTemplate": "packages/ml-engine/src/generic/pytorch/train.py",
      "featurePipeline": "configurable",
      "outputs": [
        "predictions",
        "loss_curve",
        "weights"
      ],
      "chartOverlay": "prediction_line",
      "outputDir": "data/models",
      "gpuRequired": true,
      "defaultFeatureCategories": [
        "returns",
        "volatility",
        "momentum",
        "orderflow"
      ],
      "supportedObjectives": [
        "minimize_loss",
        "maximize_accuracy",
        "maximize_sharpe"
      ],
      "estimatedTrainingTime": "5-60 min",
      "tags": [
        "supervised",
        "deep-learning",
        "neural-network",
        "lstm",
        "mlp",
        "cnn"
      ],
      "standardHyperparameters": {
        "lr": {
          "value": 0.001,
          "min": 0.0001,
          "max": 0.01,
          "step": 0.0001,
          "label": "Learning Rate",
          "type": "float",
          "description": "Optimizer step size; controls speed and stability of training",
          "group": "Training",
          "searchSpace": {
            "min": 1e-05,
            "max": 0.1,
            "scale": "log"
          }
        },
        "epochs": {
          "value": 50,
          "min": 5,
          "max": 500,
          "step": 5,
          "label": "Training Epochs",
          "type": "int",
          "description": "Number of full passes through the training dataset",
          "group": "Training",
          "searchSpace": {
            "min": 10,
            "max": 300,
            "step": 10
          }
        },
        "batch_size": {
          "value": 64,
          "min": 8,
          "max": 512,
          "step": 8,
          "label": "Batch Size",
          "type": "int",
          "description": "Number of samples per gradient update",
          "group": "Training",
          "searchSpace": {
            "min": 16,
            "max": 256,
            "options": [
              16,
              32,
              64,
              128,
              256
            ]
          }
        },
        "hidden_dims": {
          "value": [
            128,
            64
          ],
          "label": "Hidden Layer Dimensions",
          "type": "array",
          "description": "List of neuron counts for each hidden layer",
          "group": "Architecture",
          "searchSpace": {
            "presets": [
              [
                64,
                32
              ],
              [
                128,
                64
              ],
              [
                256,
                128
              ],
              [
                128,
                64,
                32
              ],
              [
                256,
                128,
                64
              ]
            ]
          }
        },
        "dropout": {
          "value": 0.2,
          "min": 0.0,
          "max": 0.8,
          "step": 0.05,
          "label": "Dropout Rate",
          "type": "float",
          "description": "Fraction of neurons randomly zeroed during training for regularization",
          "group": "Regularization",
          "searchSpace": {
            "min": 0.0,
            "max": 0.5,
            "step": 0.1
          }
        },
        "optimizer_type": {
          "value": "adam",
          "label": "Optimizer",
          "type": "categorical",
          "description": "Gradient descent optimization algorithm",
          "group": "Training",
          "choices": [
            "adam",
            "adamw",
            "sgd",
            "rmsprop",
            "radam"
          ]
        },
        "scheduler": {
          "value": "cosine",
          "label": "LR Scheduler",
          "type": "categorical",
          "description": "Learning rate scheduling strategy during training",
          "group": "Training",
          "choices": [
            "none",
            "step",
            "cosine",
            "reduce_on_plateau",
            "one_cycle"
          ]
        },
        "weight_decay": {
          "value": 0.0001,
          "min": 0.0,
          "max": 0.01,
          "step": 0.0001,
          "label": "Weight Decay",
          "type": "float",
          "description": "L2 regularization penalty on model weights",
          "group": "Regularization",
          "searchSpace": {
            "min": 1e-06,
            "max": 0.01,
            "scale": "log"
          }
        },
        "early_stopping_patience": {
          "value": 10,
          "min": 3,
          "max": 50,
          "step": 1,
          "label": "Early Stopping Patience",
          "type": "int",
          "description": "Epochs to wait for validation improvement before stopping",
          "group": "Training"
        }
      }
    },
    "xgboost": {
      "name": "XGBoost Gradient Boosting",
      "runner": "python",
      "scriptTemplate": "packages/ml-engine/src/generic/xgboost/train.py",
      "featurePipeline": "configurable",
      "outputs": [
        "predictions",
        "feature_importance",
        "shap"
      ],
      "chartOverlay": "prediction_line",
      "outputDir": "data/models",
      "gpuRequired": false,
      "defaultFeatureCategories": [
        "returns",
        "volatility",
        "momentum",
        "volume"
      ],
      "supportedObjectives": [
        "minimize_loss",
        "maximize_accuracy",
        "maximize_auc",
        "maximize_f1"
      ],
      "estimatedTrainingTime": "2-15 min",
      "tags": [
        "supervised",
        "gradient-boosting",
        "classification",
        "regression",
        "tabular"
      ],
      "standardHyperparameters": {
        "n_estimators": {
          "value": 200,
          "min": 50,
          "max": 5000,
          "step": 50,
          "label": "Number of Boosting Rounds",
          "type": "int",
          "description": "Number of gradient-boosted trees to build",
          "group": "Architecture",
          "searchSpace": {
            "min": 100,
            "max": 3000,
            "step": 100
          }
        },
        "max_depth": {
          "value": 6,
          "min": 1,
          "max": 15,
          "step": 1,
          "label": "Max Tree Depth",
          "type": "int",
          "description": "Maximum depth of each boosted tree",
          "group": "Architecture",
          "searchSpace": {
            "min": 3,
            "max": 12,
            "step": 1
          }
        },
        "learning_rate": {
          "value": 0.1,
          "min": 0.0001,
          "max": 0.01,
          "step": 0.0001,
          "label": "Learning Rate (eta)",
          "type": "float",
          "description": "Shrinkage rate applied to each tree's contribution",
          "group": "Training",
          "searchSpace": {
            "min": 1e-05,
            "max": 0.1,
            "scale": "log"
          }
        },
        "subsample": {
          "value": 0.8,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "label": "Row Subsample Ratio",
          "type": "float",
          "description": "Fraction of training rows sampled per boosting round",
          "group": "Regularization"
        },
        "colsample_bytree": {
          "value": 0.8,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "label": "Column Subsample per Tree",
          "type": "float",
          "description": "Fraction of features randomly sampled per tree",
          "group": "Regularization"
        },
        "reg_alpha": {
          "value": 0.0,
          "min": 0.0,
          "max": 10.0,
          "step": 0.1,
          "label": "L1 Regularization (alpha)",
          "type": "float",
          "description": "L1 regularization term on leaf weights; promotes sparsity",
          "group": "Regularization",
          "searchSpace": {
            "min": 1e-08,
            "max": 10.0,
            "scale": "log"
          }
        },
        "reg_lambda": {
          "value": 1.0,
          "min": 0.0,
          "max": 10.0,
          "step": 0.1,
          "label": "L2 Regularization (lambda)",
          "type": "float",
          "description": "L2 regularization term on leaf weights; prevents overfitting",
          "group": "Regularization",
          "searchSpace": {
            "min": 1e-08,
            "max": 10.0,
            "scale": "log"
          }
        },
        "min_child_weight": {
          "value": 1,
          "min": 0,
          "max": 20,
          "step": 1,
          "label": "Min Child Weight",
          "type": "int",
          "description": "Minimum sum of instance weight needed in a child node",
          "group": "Regularization",
          "searchSpace": {
            "min": 1,
            "max": 10,
            "step": 1
          }
        },
        "gamma": {
          "value": 0.0,
          "min": 0.0,
          "max": 5.0,
          "step": 0.1,
          "label": "Min Split Loss (gamma)",
          "type": "float",
          "description": "Minimum loss reduction required to make a further partition",
          "group": "Regularization",
          "searchSpace": {
            "min": 0.0,
            "max": 5.0,
            "step": 0.5
          }
        }
      }
    },
